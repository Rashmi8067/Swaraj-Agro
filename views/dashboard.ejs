<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Dashboard — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body class="dashboard-page"><header class="dash-nav"><div class="auth-brand"><img class="brand-logo" src="/swaraj-agro-default.svg" alt="Swaraj Agro logo"><div><strong><%= site.company.name %></strong><small>Admin dashboard</small></div></div><div class="dash-actions"><a class="btn ghost" href="/" target="_blank">View website ↗</a><form method="post" action="/admin/logout"><button class="btn dark">Log out</button></form></div></header><main class="dashboard"><% if(flash){ %><div class="alert <%= flash.type %>"><%= flash.msg %></div><% } %>
<nav class="admin-main-tabs" aria-label="Admin sections"><button class="admin-main-tab active" data-admin-view="frontend">Edit Frontend</button><button class="admin-main-tab" data-admin-view="enquiries">Enquiries</button></nav>
<div class="frontend-subnav" id="frontend-subnav" aria-label="Frontend editor"><button class="frontend-tab active" data-tab="home">Home Screen</button><button class="frontend-tab" data-tab="pm-suryaghar">PM Suryaghar</button><button class="frontend-tab" data-tab="products">Products</button><button class="frontend-tab" data-tab="photos">Photos</button></div>
<section class="admin-section admin-panel active" data-panel="home"><div class="admin-head"><div><span class="eyebrow">01 • HOME SCREEN</span><h1>Home screen</h1></div></div><form class="admin-grid" method="post" action="/admin/company"><label>Company name<input name="name" value="<%= site.company.name %>" required></label><label>Tagline<input name="tagline" value="<%= site.company.tagline %>"></label><label>GSTIN<input name="gstin" value="<%= site.company.gstin %>"></label><label>Email<input type="email" name="email" value="<%= site.company.email %>"></label><label>Phone numbers <span class="fine">comma-separated</span><input name="phones" value="<%= site.company.phones.join(', ') %>"></label><label>Address<textarea name="address"><%= site.company.address %></textarea></label><label>Google Maps page URL <span class="fine">Used when customers click the address / Photos link</span><input type="url" name="googleMapsUrl" value="<%= site.company.googleMapsUrl || '' %>" placeholder="https://maps.app.goo.gl/..." required></label><label>Hero title<input name="heroTitle" value="<%= site.company.heroTitle %>"></label><label>Hero text<textarea name="heroText"><%= site.company.heroText %></textarea></label><label>Short description<textarea name="description"><%= site.company.description %></textarea></label><label>About section<textarea name="about"><%= site.company.about %></textarea></label><div class="form-actions"><button class="btn primary">Save company information</button></div></form></section>
<section class="admin-section admin-panel" data-panel="pm-suryaghar"><div class="admin-head"><div><span class="eyebrow">02 • PM SURYAGHAR</span><h2>PM Suryaghar</h2></div><p>Edit the registered solar vendor information shown on the public Solar Solutions page.</p></div><form class="admin-grid pm-vendor-form" method="post" action="/admin/solar-vendor"><label>Vendor name<input name="vendorName" value="<%= site.company.solarVendor?.name || 'DS Swaraj Agro' %>"></label><label>State<input name="vendorState" value="<%= site.company.solarVendor?.state || 'Odisha' %>"></label><label>District<input name="vendorDistrict" value="<%= site.company.solarVendor?.district || 'Jajpur' %>"></label><label>Total installations<input name="vendorInstallations" value="<%= site.company.solarVendor?.installations || '114' %>" inputmode="numeric"></label><label>Total installed capacity<input name="vendorCapacity" value="<%= site.company.solarVendor?.capacity || '342 kWp' %>" placeholder="342 kWp"></label><label>Vendor rating<input name="vendorRating" value="<%= site.company.solarVendor?.rating || '5.0/5' %>" placeholder="5.0/5"></label><label>Rating count<input name="vendorRatingCount" value="<%= site.company.solarVendor?.ratingCount || '119' %>" inputmode="numeric"></label><label>Official PM Suryaghar vendor page<input type="url" name="vendorPortalUrl" value="<%= site.company.solarVendor?.portalUrl || 'https://pmsuryaghar.gov.in/#/registered-vendors' %>"></label><div class="solar-sync-admin"><div><strong>Automatic sync</strong><span><%= site.company.solarVendor?.syncStatus === 'success' ? 'Last successful sync: '+new Date(site.company.solarVendor.lastSyncedAt).toLocaleString('en-IN') : 'Waiting for a successful official data response.' %></span></div><button class="btn ghost" type="button" id="pm-sync-button">Sync from PM Suryaghar now ↻</button></div><div class="form-actions"><button class="btn primary">Save PM Suryaghar information</button></div></form><div class="admin-subsection-heading branch-manager-heading"><span class="eyebrow">BRANCH LOCATIONS</span><h3>Branches</h3><p>Manage your physical branch locations without leaving the frontend editor.</p></div><div class="manage-list"><% site.branches.forEach(b=>{ %><article class="manage-card"><div><strong><%= b.name %></strong><span><%= b.city %> · <%= b.address %></span></div><div class="row-actions"><button class="btn ghost edit-branch" type="button" data-id="<%= b.id %>" data-name="<%= b.name %>" data-city="<%= b.city %>" data-address="<%= b.address %>" data-googlemapsurl="<%= b.googleMapsUrl || '' %>" data-phone="<%= b.phone %>" data-email="<%= b.email %>" data-description="<%= b.description %>" data-gallerycount="<%= (b.gallery||[]).length || (b.image?1:0) %>">Edit</button><form method="post" action="/admin/branches/delete" onsubmit="return confirm('Delete this branch?')"><input type="hidden" name="id" value="<%= b.id %>"><button class="btn danger">Delete</button></form></div></article><% }) %></div><details class="editor" open><summary>Add / edit branch</summary><form class="admin-grid" id="branch-form" method="post" action="/admin/branches/save" enctype="multipart/form-data"><input type="hidden" name="id" id="branch-id" value=""><label>Branch name<input name="name" id="branch-name" required></label><label>City / area<input name="city" id="branch-city"></label><label>Address<textarea name="address" id="branch-address"></textarea></label><label>Google Maps page URL <span class="fine">Optional — customers can click the branch address to open this location</span><input type="url" name="googleMapsUrl" id="branch-googleMapsUrl" placeholder="https://maps.app.goo.gl/..."></label><label>Phone<input name="phone" id="branch-phone"></label><label>Email<input type="email" name="email" id="branch-email"></label><label>Cover photo<input type="file" name="image" accept="image/jpeg,image/png,image/webp"></label><label>Additional branch photos <span class="fine">Up to 8 · added to the branch gallery</span><input type="file" name="gallery" accept="image/jpeg,image/png,image/webp" multiple></label><label>Description<textarea name="description" id="branch-description"></textarea></label><div class="form-actions"><button class="btn ghost" type="button" id="branch-clear">Clear</button><button class="btn primary">Save branch</button></div></form></details></section>
<section class="admin-section admin-panel" data-panel="products"><div class="admin-head"><div><span class="eyebrow">03 • PRODUCTS</span><h2>Product catalog</h2></div><p>Exactly two main categories. Use the subcategory field to organize products inside each one.</p></div><div class="manage-list"><% site.products.forEach(p=>{ %><article class="manage-card"><div class="product-mini"><% if(p.image){ %><img src="<%= p.image %>"><% } else { %><span>DS</span><% } %><div><strong><%= p.name %></strong><span><%= p.category %> · <%= p.subcategory || 'No subcategory' %> · <%= p.price %> · <%= (p.gallery||[]).length || (p.image?1:0) %> photos</span></div></div><div class="row-actions"><button class="btn ghost edit-product" type="button" data-id="<%= p.id %>" data-name="<%= p.name %>" data-category="<%= p.category %>" data-subcategory="<%= p.subcategory || '' %>" data-price="<%= p.price %>" data-description="<%= p.description %>" data-featured="<%= p.featured ? '1' : '0' %>"  data-gallerycount="<%= (p.gallery||[]).length || (p.image?1:0) %>">Edit</button><form method="post" action="/admin/products/delete" onsubmit="return confirm('Delete this product?')"><input type="hidden" name="id" value="<%= p.id %>"><button class="btn danger">Delete</button></form></div></article><% }) %></div><details class="editor" open><summary>Add / edit product</summary><form class="admin-grid" id="product-form" method="post" action="/admin/products/save" enctype="multipart/form-data"><input type="hidden" name="id" id="product-id" value=""><label>Product / service name<input name="name" id="product-name" required></label><label>Main category<select name="category" id="product-category" required><option value="Solar Solution">Solar Solution</option><option value="Farm Machinery">Farm Machinery</option></select></label><label>Subcategory<input name="subcategory" id="product-subcategory" placeholder="e.g. Rooftop Solar / Rotavator"></label><label>Price<input name="price" id="product-price" placeholder="₹ 1,25,000"></label><label>Cover photo<input type="file" name="image" accept="image/jpeg,image/png,image/webp"></label><label>Additional product photos <span class="fine">Up to 8 · added to the swipeable gallery</span><input type="file" name="gallery" accept="image/jpeg,image/png,image/webp" multiple></label><label>Description<textarea name="description" id="product-description"></textarea></label><label class="check"><input type="checkbox" name="featured" id="product-featured"> Show as featured</label><div class="form-actions"><button class="btn ghost" type="button" id="product-clear">Clear</button><button class="btn primary">Save product</button></div></form></details></section>
<section class="admin-section admin-panel" data-panel="photos"><div class="admin-head"><div><span class="eyebrow">04 • PHOTOS</span><h2>Photo gallery</h2></div><p>Upload photos for the public gallery. Choose up to 4 to feature on the homepage.</p></div><form class="admin-grid" method="post" action="/admin/photos/upload" enctype="multipart/form-data"><label>Photos <span class="fine">Up to 20 images per upload · JPG, PNG or WEBP</span><input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple required></label><label>Caption <span class="fine">Optional caption applied to all selected photos</span><input name="caption" placeholder="e.g. Rooftop solar installation completed in Jajpur"></label><label>Category <span class="fine">All uploaded photos will be placed in this category</span><select name="category"><option>Farm Machinery</option><option>Solar Rooftop Installation</option><option>Office Inside</option><option>Exterior</option><option>Other</option></select></label><div class="form-actions"><button class="btn primary">Upload photos</button></div></form><form method="post" action="/admin/photos/home-featured" class="home-photo-selector"><div class="photo-selector-head"><div><strong>Homepage photos</strong><span class="fine">Select up to 4. These are the photos visitors see on the home page.</span></div><button class="btn primary" type="submit">Save homepage photos</button></div><div class="manage-list photo-admin-list"><% (site.photos||[]).forEach(photo=>{ %><article class="manage-card photo-select-card"><label class="photo-check"><input type="checkbox" name="homePhotoIds" value="<%= photo.id %>" <%= photo.homeFeatured ? 'checked' : '' %>><span>Show on home</span></label><div class="photo-admin"><img src="<%= photo.image %>" alt=""><div><strong><%= photo.caption || 'Untitled photo' %></strong><span><%= photo.homeFeatured ? 'Featured on homepage' : 'Gallery only' %></span><label class="photo-category-field">Category<select name="photoCategory_<%= photo.id %>"><option <%= (photo.category||'Other')==='Farm Machinery' ? 'selected' : '' %>>Farm Machinery</option><option <%= (photo.category||'Other')==='Solar Rooftop Installation' ? 'selected' : '' %>>Solar Rooftop Installation</option><option <%= (photo.category||'Other')==='Office Inside' ? 'selected' : '' %>>Office Inside</option><option <%= (photo.category||'Other')==='Exterior' ? 'selected' : '' %>>Exterior</option><option <%= (photo.category||'Other')==='Other' ? 'selected' : '' %>>Other</option></select></label></div></div><button class="btn danger photo-delete-btn" type="submit" name="deletePhotoId" value="<%= photo.id %>" formmethod="post" formaction="/admin/photos/delete" formnovalidate onclick="return confirm('Delete this photo?')">Delete</button></article><% }) %></div></form></section>

<section class="admin-section admin-panel" data-panel="enquiries"><div class="admin-head"><div><span class="eyebrow">02 • ENQUIRIES</span><h2>Product enquiries</h2></div><p>Customer enquiries submitted from product pages.</p></div><div class="enquiry-filter-bar"><label>View enquiries for a date<input type="date" id="enquiry-date-filter"></label><button class="btn ghost" type="button" id="clear-enquiry-filter">Show all dates</button></div><div class="manage-list" id="enquiry-list"><% const enquiryList=[...(site.enquiries||[])].sort((a,b)=>new Date(b.createdAt||0)-new Date(a.createdAt||0)); %><% if(!enquiryList.length){ %><div class="empty-card"><h3>No enquiries yet</h3><p>Product enquiries will appear here.</p></div><% } %><% enquiryList.forEach(e=>{ %><article class="manage-card enquiry-admin-card" data-enquiry-date="<%= new Date(e.createdAt).toLocaleDateString('en-CA',{timeZone:'Asia/Kolkata'}) %>"><div><strong><%= e.product %></strong><span><%= e.name %> · <%= e.phone %> · <%= e.category || 'Product' %></span><span><%= new Date(e.createdAt).toLocaleString('en-IN') %></span></div><div class="row-actions"><a class="btn primary" href="tel:<%= e.phone %>">Call</a><a class="btn ghost" href="https://wa.me/91<%= String(e.phone||'').replace(/\D/g,'') %>?text=<%= encodeURIComponent('Hello '+e.name+', thank you for your enquiry about '+e.product+'. Our Swaraj Agro team will contact you shortly.') %>" target="_blank" rel="noopener">WhatsApp</a><form method="post" action="/admin/enquiries/delete" onsubmit="return confirm('Delete this enquiry?')"><input type="hidden" name="id" value="<%= e.id %>"><button class="btn danger">Delete</button></form></div></article><% }) %></div></section>
<script>
const $=id=>document.getElementById(id), details=[...document.querySelectorAll('.editor')];function openEditor(i){details[i].open=true;details[i].scrollIntoView({behavior:'smooth',block:'center'})}
document.querySelectorAll('.edit-branch').forEach(btn=>btn.addEventListener('click',()=>{$('branch-id').value=btn.dataset.id;$('branch-name').value=btn.dataset.name;$('branch-city').value=btn.dataset.city;$('branch-address').value=btn.dataset.address;$('branch-googleMapsUrl').value=btn.dataset.googlemapsurl||'';$('branch-phone').value=btn.dataset.phone;$('branch-email').value=btn.dataset.email;$('branch-description').value=btn.dataset.description;openEditor(0)}));$('branch-clear').addEventListener('click',()=>{['branch-id','branch-name','branch-city','branch-address','branch-googleMapsUrl','branch-phone','branch-email','branch-description'].forEach(id=>$(id).value='')});
document.querySelectorAll('.edit-product').forEach(btn=>btn.addEventListener('click',()=>{$('product-id').value=btn.dataset.id;$('product-name').value=btn.dataset.name;$('product-category').value=btn.dataset.category;$('product-subcategory').value=btn.dataset.subcategory;$('product-price').value=btn.dataset.price;$('product-description').value=btn.dataset.description;$('product-featured').checked=btn.dataset.featured==='1';openEditor(1)}));$('product-clear').addEventListener('click',()=>{['product-id','product-name','product-subcategory','product-price','product-description'].forEach(id=>$(id).value='');$('product-category').value='Solar Solution';$('product-featured').checked=false});

const homePhotoChecks=[...document.querySelectorAll('input[name="homePhotoIds"]')];
homePhotoChecks.forEach(ch=>ch.addEventListener('change',()=>{ const n=homePhotoChecks.filter(x=>x.checked).length; if(n>4){ ch.checked=false; alert('You can select a maximum of 4 homepage photos.'); }}));

const frontendTabs=[...document.querySelectorAll('.frontend-tab')],panels=[...document.querySelectorAll('.admin-panel')],mainTabs=[...document.querySelectorAll('.admin-main-tab')],subnav=document.getElementById('frontend-subnav');function showPanel(key){frontendTabs.forEach(x=>x.classList.toggle('active',x.dataset.tab===key));panels.forEach(x=>x.classList.toggle('active',x.dataset.panel===key));history.replaceState(null,'','#'+key)}frontendTabs.forEach(tab=>tab.addEventListener('click',()=>showPanel(tab.dataset.tab)));mainTabs.forEach(tab=>tab.addEventListener('click',()=>{const view=tab.dataset.adminView;mainTabs.forEach(x=>x.classList.toggle('active',x===tab));if(view==='enquiries'){subnav.classList.remove('visible');showPanel('enquiries')}else{subnav.classList.add('visible');showPanel('home')}}));const initial=location.hash.replace('#','');if(initial==='enquiries'){mainTabs.forEach(x=>x.classList.toggle('active',x.dataset.adminView==='enquiries'));subnav.classList.remove('visible');showPanel('enquiries')}else{if(initial&&frontendTabs.some(x=>x.dataset.tab===initial))showPanel(initial);else showPanel('home')}const dateFilter=document.getElementById('enquiry-date-filter'),clearFilter=document.getElementById('clear-enquiry-filter');function filterEnquiries(){const value=dateFilter?.value||'';document.querySelectorAll('.enquiry-admin-card').forEach(card=>card.style.display=!value||card.dataset.enquiryDate===value?'':'none')}dateFilter?.addEventListener('change',filterEnquiries);clearFilter?.addEventListener('click',()=>{dateFilter.value='';filterEnquiries()});const syncBtn=document.getElementById('pm-sync-button');syncBtn?.addEventListener('click',()=>{const f=document.createElement('form');f.method='post';f.action='/admin/solar-vendor/sync';document.body.appendChild(f);f.submit()});
</script>
</main></body></html>