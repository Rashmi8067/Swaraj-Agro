<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Dashboard — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body class="dashboard-page"><header class="dash-nav"><div class="auth-brand"><% if(site.company.logo){ %><img class="brand-logo" src="<%= site.company.logo %>" alt="logo"><% } else { %><span class="brand-mark">DS</span><% } %><div><strong><%= site.company.name %></strong><small>Admin dashboard</small></div></div><div class="dash-actions"><a class="btn ghost" href="/" target="_blank">View website ↗</a><form method="post" action="/admin/logout"><button class="btn dark">Log out</button></form></div></header><main class="dashboard"><% if(flash){ %><div class="alert <%= flash.type %>"><%= flash.msg %></div><% } %>
<section class="admin-section"><div class="admin-head"><div><span class="eyebrow">01 • COMPANY</span><h1>Company information</h1></div></div><form class="admin-grid" method="post" action="/admin/company" enctype="multipart/form-data"><label>Company name<input name="name" value="<%= site.company.name %>" required></label><label>Tagline<input name="tagline" value="<%= site.company.tagline %>"></label><label>GSTIN<input name="gstin" value="<%= site.company.gstin %>"></label><label>Email<input type="email" name="email" value="<%= site.company.email %>"></label><label>Phone numbers <span class="fine">comma-separated</span><input name="phones" value="<%= site.company.phones.join(', ') %>"></label><label>Address<textarea name="address"><%= site.company.address %></textarea></label><label>Logo <span class="fine">JPG, PNG or WEBP</span><input type="file" name="logo" accept="image/jpeg,image/png,image/webp"><% if(site.company.logo){ %><small class="current-file">Current logo: <%= site.company.logo %></small><% } %></label><label>Hero title<input name="heroTitle" value="<%= site.company.heroTitle %>"></label><label>Hero text<textarea name="heroText"><%= site.company.heroText %></textarea></label><label>Short description<textarea name="description"><%= site.company.description %></textarea></label><label>About section<textarea name="about"><%= site.company.about %></textarea></label><div class="form-actions"><button class="btn primary">Save company information</button></div></form></section>
<section class="admin-section"><div class="admin-head"><div><span class="eyebrow">02 • BRANCHES</span><h2>Branches</h2></div><p>Add, edit or remove branch locations.</p></div><div class="manage-list"><% site.branches.forEach(b=>{ %><article class="manage-card"><div><strong><%= b.name %></strong><span><%= b.city %> · <%= b.address %></span></div><div class="row-actions"><button class="btn ghost edit-branch" type="button" data-id="<%= b.id %>" data-name="<%= b.name %>" data-city="<%= b.city %>" data-address="<%= b.address %>" data-phone="<%= b.phone %>" data-email="<%= b.email %>" data-description="<%= b.description %>">Edit</button><form method="post" action="/admin/branches/delete" onsubmit="return confirm('Delete this branch?')"><input type="hidden" name="id" value="<%= b.id %>"><button class="btn danger">Delete</button></form></div></article><% }) %></div><details class="editor" open><summary>Add / edit branch</summary><form class="admin-grid" id="branch-form" method="post" action="/admin/branches/save" enctype="multipart/form-data"><input type="hidden" name="id" id="branch-id" value=""><label>Branch name<input name="name" id="branch-name" required></label><label>City / area<input name="city" id="branch-city"></label><label>Address<textarea name="address" id="branch-address"></textarea></label><label>Phone<input name="phone" id="branch-phone"></label><label>Email<input type="email" name="email" id="branch-email"></label><label>Photo<input type="file" name="image" accept="image/jpeg,image/png,image/webp"></label><label>Description<textarea name="description" id="branch-description"></textarea></label><div class="form-actions"><button class="btn ghost" type="button" id="branch-clear">Clear</button><button class="btn primary">Save branch</button></div></form></details></section>
<section class="admin-section"><div class="admin-head"><div><span class="eyebrow">03 • PRODUCTS</span><h2>Product catalog</h2></div><p>Exactly two main categories. Use the subcategory field to organize products inside each one.</p></div><div class="manage-list"><% site.products.forEach(p=>{ %><article class="manage-card"><div class="product-mini"><% if(p.image){ %><img src="<%= p.image %>"><% } else { %><span>DS</span><% } %><div><strong><%= p.name %></strong><span><%= p.category %> · <%= p.subcategory || 'No subcategory' %> · <%= p.price %></span></div></div><div class="row-actions"><button class="btn ghost edit-product" type="button" data-id="<%= p.id %>" data-name="<%= p.name %>" data-category="<%= p.category %>" data-subcategory="<%= p.subcategory || '' %>" data-price="<%= p.price %>" data-description="<%= p.description %>" data-featured="<%= p.featured ? '1' : '0' %>">Edit</button><form method="post" action="/admin/products/delete" onsubmit="return confirm('Delete this product?')"><input type="hidden" name="id" value="<%= p.id %>"><button class="btn danger">Delete</button></form></div></article><% }) %></div><details class="editor" open><summary>Add / edit product</summary><form class="admin-grid" id="product-form" method="post" action="/admin/products/save" enctype="multipart/form-data"><input type="hidden" name="id" id="product-id" value=""><label>Product / service name<input name="name" id="product-name" required></label><label>Main category<select name="category" id="product-category" required><option value="Solar Solution">Solar Solution</option><option value="Farm Machinery">Farm Machinery</option></select></label><label>Subcategory<input name="subcategory" id="product-subcategory" placeholder="e.g. Rooftop Solar / Rotavator"></label><label>Price<input name="price" id="product-price" placeholder="₹ 1,25,000"></label><label>Photo<input type="file" name="image" accept="image/jpeg,image/png,image/webp"></label><label>Description<textarea name="description" id="product-description"></textarea></label><label class="check"><input type="checkbox" name="featured" id="product-featured"> Show as featured</label><div class="form-actions"><button class="btn ghost" type="button" id="product-clear">Clear</button><button class="btn primary">Save product</button></div></form></details></section>
<section class="admin-section security"><div class="admin-head"><div><span class="eyebrow">04 • SECURITY</span><h2>Password reset</h2></div></div><p>The reset address is <strong><%= resetEmail %></strong>. Configure SMTP in <code>.env</code> before deploying so OTPs are delivered to the mailbox.</p></section>
</main><script>
const $=id=>document.getElementById(id), details=[...document.querySelectorAll('.editor')];function openEditor(i){details[i].open=true;details[i].scrollIntoView({behavior:'smooth',block:'center'})}
document.querySelectorAll('.edit-branch').forEach(btn=>btn.addEventListener('click',()=>{$('branch-id').value=btn.dataset.id;$('branch-name').value=btn.dataset.name;$('branch-city').value=btn.dataset.city;$('branch-address').value=btn.dataset.address;$('branch-phone').value=btn.dataset.phone;$('branch-email').value=btn.dataset.email;$('branch-description').value=btn.dataset.description;openEditor(0)}));$('branch-clear').addEventListener('click',()=>{['branch-id','branch-name','branch-city','branch-address','branch-phone','branch-email','branch-description'].forEach(id=>$(id).value='')});
document.querySelectorAll('.edit-product').forEach(btn=>btn.addEventListener('click',()=>{$('product-id').value=btn.dataset.id;$('product-name').value=btn.dataset.name;$('product-category').value=btn.dataset.category;$('product-subcategory').value=btn.dataset.subcategory;$('product-price').value=btn.dataset.price;$('product-description').value=btn.dataset.description;$('product-featured').checked=btn.dataset.featured==='1';openEditor(1)}));$('product-clear').addEventListener('click',()=>{['product-id','product-name','product-subcategory','product-price','product-description'].forEach(id=>$(id).value='');$('product-category').value='Solar Solution';$('product-featured').checked=false});
</script></body></html>
