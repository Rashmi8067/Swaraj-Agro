<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact — <%= site.company.name %></title><meta name="description" content="Contact <%= site.company.name %>"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'contact' }) %>
<main><section class="page-hero section"><span class="eyebrow">CONTACT US</span><h1>Let's talk about what you need.</h1><p>For product enquiries, solar rooftop installation support, pricing or branch information.</p></section><section class="section contact"><div class="contact-card"><div><span class="eyebrow">DIRECT CONTACT</span><h2><%= site.company.name %></h2><p>Reach our team directly through phone, email or Google Maps.</p></div><div class="contact-details"><% site.company.phones.forEach(phone=>{ %><a href="tel:<%= phone %>"><%= phone %></a><% }) %><a href="mailto:<%= site.company.email %>"><%= site.company.email %></a><% if(site.company.googleMapsUrl){ %><a class="address-link" href="<%= site.company.googleMapsUrl %>" target="_blank" rel="noopener noreferrer"><%= site.company.address %> ↗</a><% } else { %><span><%= site.company.address %></span><% } %><p class="muted">GSTIN: <%= site.company.gstin %></p></div></div></section><section class="section enquiry-section"><div class="enquiry-card"><div><span class="eyebrow">SEND US AN ENQUIRY</span><h2>Tell us what you need.</h2><p>Submit your enquiry here and our team will contact you shortly.</p></div><form id="enquiry-form" class="enquiry-form"><label>Your name<input id="enq-name" required placeholder="Your name"></label><label>Phone number<input id="enq-phone" required inputmode="tel" placeholder="Your phone number"></label><label>Interested in<select id="enq-interest"><option value="Farm Machinery">Farm Machinery</option><option value="Solar Rooftop Installation">Solar Rooftop Installation</option><option value="Other">Other</option></select></label><label id="enq-product-wrap">Select product<select id="enq-product"><option value="">Select a product</option><% (site.products||[]).filter(p=>p.category==='Farm Machinery').forEach(p=>{ %><option value="<%= p.name %>"><%= p.name %><% if(p.brand){ %> — <%= p.brand %><% } %></option><% }) %></select></label><label>Location<input id="enq-location" placeholder="Your location"></label><label class="full-field">Message<textarea id="enq-message" placeholder="Your message (optional)"></textarea></label><button class="btn primary full-field" type="submit">Submit Enquiry →</button></form></div></section><div class="enquiry-popup" id="contact-success" aria-hidden="true"><div class="enquiry-popup-card enquiry-success"><div class="enquiry-success-icon">✓</div><h3>Successfully submitted</h3><p>Our team will contact you shortly.</p><button type="button" class="btn primary" id="contact-success-close">Done</button></div></div></main><script>(()=>{const f=document.getElementById('enquiry-form'),interest=document.getElementById('enq-interest'),productWrap=document.getElementById('enq-product-wrap'),product=document.getElementById('enq-product'),popup=document.getElementById('contact-success');if(!f)return;const sync=()=>{const isFarm=interest.value==='Farm Machinery';productWrap.style.display=isFarm?'flex':'none';product.required=isFarm;};interest.addEventListener('change',sync);sync();f.addEventListener('submit',async e=>{e.preventDefault();const body={name:document.getElementById('enq-name').value.trim(),phone:document.getElementById('enq-phone').value.trim(),category:interest.value,product:product.value,location:document.getElementById('enq-location').value.trim(),message:document.getElementById('enq-message').value.trim()};try{const r=await fetch('/enquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const data=await r.json();if(!r.ok)throw new Error(data.message||'Could not submit enquiry.');f.reset();sync();popup.classList.add('open');popup.setAttribute('aria-hidden','false')}catch(err){alert(err.message)}});document.getElementById('contact-success-close').addEventListener('click',()=>{popup.classList.remove('open');popup.setAttribute('aria-hidden','true')});popup.addEventListener('click',e=>{if(e.target===popup){popup.classList.remove('open');popup.setAttribute('aria-hidden','true')}})})();</script><%- include('partials/footer') %></body></html>
