<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body><header class="nav"><a class="brand" href="/"><% if(site.company.logo){ %><img class="brand-logo" src="<%= site.company.logo %>"><% } else { %><img class="brand-logo brand-logo-default" src="/swaraj-agro-default.svg" alt="Swaraj Agro logo"><% } %><span><strong><%= site.company.name %></strong><small>Agro • Solar • Equipment</small></span></a><nav><a href="/">Home</a><a href="/products?category=Solar%20Solution">Solar Solutions</a><a href="/products?category=Farm%20Machinery">Farm Machinery</a><a href="/branches">Branches</a><a href="/photos">Photos</a><a class="active" href="/contact">Contact</a><a class="admin-link" href="/admin/login">Admin</a></nav></header><main><section class="page-hero section"><span class="eyebrow">CONTACT US</span><h1>Let's talk about what you need.</h1><p>For product enquiries, solar rooftop installation support, pricing or branch information.</p></section><section class="section contact"><div class="contact-card"><div><span class="eyebrow">DIRECT CONTACT</span><h2><%= site.company.name %></h2><p>Reach our team directly through phone, email or Google Maps.</p></div><div class="contact-details"><% site.company.phones.forEach(phone=>{ %><a href="tel:<%= phone %>">+91 <%= phone %></a><% }) %><a href="mailto:<%= site.company.email %>"><%= site.company.email %></a><a class="address-link" href="<%= site.company.googleMapsUrl || '#' %>" target="_blank" rel="noopener noreferrer"><%= site.company.address %> ↗</a><p class="muted">GSTIN: <%= site.company.gstin %></p></div></div></section></main><%- include('partials/footer') %></body></html>
