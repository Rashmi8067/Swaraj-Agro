<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact — <%= site.company.name %></title><link rel="stylesheet" href="/site.css"></head><body><%- include('partials/public-header',{site,path:'/contact'}) %><main><section class="page-hero"><div class="page-hero-inner"><span class="section-kicker">CONTACT US</span><h1>Let's talk about what you need.</h1><p>For product enquiries, solar rooftop installation support, pricing or branch information.</p></div></section><section class="content-section section"><div class="contact-grid"><div class="contact-card"><span class="section-kicker">DIRECT CONTACT</span><h2 class="section-title"><%= site.company.name %></h2><p class="section-sub">Reach our team directly through phone, email or Google Maps.</p><div class="contact-details"><% site.company.phones.forEach(phone=>{ %><a href="tel:<%= phone %>">+91 <%= phone %></a><% }) %><a href="mailto:<%= site.company.email %>"><%= site.company.email %></a><a href="<%= site.company.googleMapsUrl || '#' %>" target="_blank" rel="noopener noreferrer"><%= site.company.address %> ↗</a></div></div><aside class="contact-note"><span class="section-kicker" style="color:#d9fb63">VISIT US</span><h2 class="section-title" style="color:#fff">Find Swaraj Agro.</h2><p><%= site.company.address %></p><a class="maps-link" href="<%= site.company.googleMapsUrl || '#' %>" target="_blank" rel="noopener noreferrer">Open in Google Maps →</a><p>GSTIN: <%= site.company.gstin %></p></aside></div></section></main><%- include('partials/public-footer',{site}) %></body></html>
