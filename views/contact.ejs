<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact — <%= site.company.name %></title><meta name="description" content="Contact <%= site.company.name %>"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'contact' }) %>
<main><section class="page-hero section"><span class="eyebrow">CONTACT US</span><h1>Let's talk about what you need.</h1><p>For product enquiries, solar rooftop installation support, pricing or branch information.</p></section><section class="section contact"><div class="contact-card"><div><span class="eyebrow">DIRECT CONTACT</span><h2><%= site.company.name %></h2><p>Reach our team directly through phone, email or Google Maps.</p></div><div class="contact-details"><% site.company.phones.forEach(phone=>{ %><a href="tel:<%= phone %>"><%= phone %></a><% }) %><a href="mailto:<%= site.company.email %>"><%= site.company.email %></a><% if(site.company.googleMapsUrl){ %><a class="address-link" href="<%= site.company.googleMapsUrl %>" target="_blank" rel="noopener noreferrer"><%= site.company.address %> ↗</a><% } else { %><span><%= site.company.address %></span><% } %><p class="muted">GSTIN: <%= site.company.gstin %></p></div></div></section></main><%- include('partials/footer') %></body></html>
