<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Login — DS Swaraj Agro</title><link rel="stylesheet" href="/style.css"></head><body class="admin-page"><div class="auth-shell"><div class="auth-brand"><span class="brand-mark">DS</span><div><strong>DS Swaraj Agro</strong><small>Administration</small></div></div><div class="auth-card"><span class="eyebrow">ADMIN ACCESS</span><h1>Sign in</h1><p class="muted">Manage company information, branches, products, prices and images.</p><% if(typeof error !== 'undefined' && error){ %><div class="alert error"><%= error %></div><% } %><% if(typeof success !== 'undefined' && success){ %><div class="alert success"><%= success %></div><% } %><form method="post" action="/admin/login"><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="btn primary full">Sign in</button></form><details><summary>Forgot password?</summary><form method="post" action="/admin/reset/request" class="mini-form"><label>Reset email<input type="email" name="email" value="<%= resetEmail %>" required></label><button class="btn ghost full">Send OTP</button></form><p class="fine">OTP reset is configured for <strong><%= resetEmail %></strong>. Real email delivery requires SMTP settings in <code>.env</code>.</p></details></div><a class="back" href="/">← Back to website</a></div></body></html>
