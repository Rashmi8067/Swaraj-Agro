<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Login — Swaraj Agro</title><link rel="stylesheet" href="/style.css"></head><body class="admin-page"><div class="auth-shell"><button type="button" class="site-theme-toggle admin-login-theme" id="admin-login-theme" aria-label="Switch theme" title="Switch theme"><span class="theme-sun">☀</span><span class="theme-moon">◐</span></button><div class="auth-brand"><span class="auth-logo-badge leaf-logo" aria-hidden="true"><svg viewBox="0 0 64 64" role="img"><path d="M50 10C30 11 16 20 13 35c-2 10 5 18 15 18 16 0 24-15 22-43Z" fill="currentColor"/><path d="M16 49C25 39 34 30 47 20" fill="none" stroke="#f7f0df" stroke-width="4" stroke-linecap="round"/></svg></span><div><strong>Swaraj Agro</strong><small>Administration</small></div></div><div class="auth-card"><span class="eyebrow">ADMIN ACCESS</span><h1>Sign in</h1><p class="muted">Manage company information, branches, products, prices and images.</p><% if(typeof error !== 'undefined' && error){ %><div class="alert error"><%= error %></div><% } %><% if(typeof success !== 'undefined' && success){ %><div class="alert success"><%= success %></div><% } %><form method="post" action="/admin/login"><input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/admin' %>"><label>Password<input type="password" name="password" autocomplete="current-password" required></label><label class="remember-row"><input type="checkbox" name="rememberMe" <%= typeof rememberMe !== 'undefined' && rememberMe ? 'checked' : '' %>> <span>Remember me</span></label><button class="btn primary full">Sign in</button></form></div><a class="back" href="/">← Back to website</a></div><script>document.addEventListener('DOMContentLoaded',()=>{const root=document.documentElement,body=document.body,btn=document.getElementById('admin-login-theme');const apply=t=>{root.dataset.siteTheme=t;body.classList.toggle('site-dark',t==='dark');localStorage.setItem('swarajTheme',t);localStorage.setItem('swarajSiteTheme',t);btn?.classList.toggle('is-dark',t==='dark')};apply(localStorage.getItem('swarajTheme')||localStorage.getItem('swarajSiteTheme')||'light');btn?.addEventListener('click',()=>apply(root.dataset.siteTheme==='dark'?'light':'dark'));window.addEventListener('storage',e=>{if(e.key==='swarajTheme'&&e.newValue)apply(e.newValue)});});</script></body></html>
