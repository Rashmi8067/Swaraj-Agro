<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Login — Swaraj Agro</title><link rel="stylesheet" href="/style.css"></head><body class="admin-page"><div class="auth-shell"><div class="auth-brand"><span class="minimal-leaf-logo" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M31.5 7.5C20.3 8.1 11.7 13.1 9.2 21.5c-1.5 5.1 1.1 9.2 5.6 10.5 6.5 1.9 12.9-2.8 15.2-9.6 1.4-4.2 1.8-9.4 1.5-14.9Z"/><path d="M10.5 30.8c5.1-5.2 10.2-9.6 17.3-14.1"/></svg></span><div><strong>Swaraj Agro</strong><small>Administration</small></div></div><div class="auth-card"><span class="eyebrow">ADMIN ACCESS</span><h1>Sign in</h1><p class="muted">Manage company information, branches, products, prices and images.</p><% if(typeof error !== 'undefined' && error){ %><div class="alert error"><%= error %></div><% } %><% if(typeof success !== 'undefined' && success){ %><div class="alert success"><%= success %></div><% } %><form method="post" action="/admin/login"><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="btn primary full">Sign in</button></form><details><summary>Forgot password?</summary><form method="post" action="/admin/reset/request" class="mini-form"><label>Reset email<input type="email" name="email" value="<%= resetEmail %>" required></label><button class="btn ghost full">Send OTP</button></form><p class="fine">OTP reset is configured for <strong><%= resetEmail %></strong>. Real email delivery requires SMTP settings in <code>.env</code>.</p></details></div><a class="back" href="/">← Back to website</a></div></body></html>
