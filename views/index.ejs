<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= site.company.name %> — <%= site.company.tagline %></title><meta name="description" content="<%= site.company.description %>"><link rel="stylesheet" href="/style.css"></head><body>
<header class="nav"><a class="brand" href="#home"><% if(site.company.logo){ %><img class="brand-logo" src="<%= site.company.logo %>" alt="<%= site.company.name %> logo"><% } else { %><span class="brand-mark">DS</span><% } %><span><strong><%= site.company.name %></strong><small>Agro • Solar • Equipment</small></span></a><nav><a href="#about">About</a><a href="#products">Products</a><a href="#branches">Branches</a><a href="/photos">Photos</a><a href="#contact">Contact</a><a class="admin-link" href="/admin/login">Admin</a></nav></header>
<main id="home">
<section class="hero"><div class="hero-copy"><span class="eyebrow">AUTHORIZED SOLAR VENDOR • FARM EQUIPMENT</span><h1><%= site.company.heroTitle %></h1><p><%= site.company.heroText %></p><div class="hero-actions"><a class="btn primary" href="#products">Explore products</a><a class="btn ghost" href="#contact">Get in touch</a><a class="btn ghost" href="/photos">Photos</a></div><div class="hero-note"><span>☀</span> Solar rooftop installation under PM Suryaghar Muft Bijli Yojana</div></div><div class="hero-art"><% if(site.company.bannerImage){ %><img class="hero-banner-img" src="<%= site.company.bannerImage %>" alt="<%= site.company.name %>"><% } else { %><div class="sun"></div><div class="field field-1"></div><div class="field field-2"></div><div class="panel"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><% } %></div></section>
<section class="stats"><% site.company.stats.forEach(s=>{ %><div><strong><%= s.value %></strong><span><%= s.label %></span></div><% }) %></section>

<section id="products" class="section"><div class="section-head"><div><span class="eyebrow">PRODUCTS & SERVICES</span><h2>What we offer</h2></div><p>Choose a category to browse, or search across everything we offer.</p></div>
<form class="product-search" action="/products" method="get"><input type="text" name="q" placeholder="Search products, e.g. rotavator, rooftop solar..." aria-label="Search products"><button class="btn primary" type="submit">Search</button></form>
<div class="category-grid two"><a class="category-card" href="/products?category=<%= encodeURIComponent('Solar Solution') %>"><span>01</span><strong>Solar Solution</strong><small>Rooftop & solar services &rarr;</small></a><a class="category-card" href="/products?category=<%= encodeURIComponent('Farm Machinery') %>"><span>02</span><strong>Farm Machinery</strong><small>Equipment & harvesting &rarr;</small></a></div>
</section>
<section id="branches" class="section alt"><div class="section-head"><div><span class="eyebrow">OUR PRESENCE</span><h2>Branch locations</h2></div><p>Click a location to view its complete branch details.</p></div><div class="branch-locations"><% if(!site.branches.length){ %><div class="empty-card"><h3>More locations coming soon</h3><p>Branch locations can be added by the administrator.</p></div><% } %><% site.branches.forEach((b,i)=>{ %><button class="location-card" type="button" data-branch="branch-<%= i %>"><span class="location-pin">⌖</span><span><strong><%= b.name %></strong><small><%= b.city || b.address %></small></span><span class="location-arrow">→</span></button><div class="branch-data hidden" id="branch-<%= i %>"><div class="branch-modal-content"><% if(b.image){ %><img src="<%= b.image %>" alt="<%= b.name %>"><% } %><span class="tag"><%= b.city %></span><h3><%= b.name %></h3><p><%= b.description %></p><p class="muted"><strong>Address:</strong> <%= b.address %></p><p class="muted"><strong>Phone:</strong> <%= b.phone || 'Not provided' %></p><p class="muted"><strong>Email:</strong> <%= b.email || 'Not provided' %></p></div></div><% }) %></div></section>
<section id="photos" class="section"><div class="section-head"><div><span class="eyebrow">PHOTO GALLERY</span><h2>See our work.</h2></div><p>A quick look at our work and activities. Swipe on mobile or open the full gallery.</p></div><div class="photo-actions"><a class="btn primary" href="<%= site.company.googleMapsUrl || '#' %>" target="_blank" rel="noopener noreferrer">Open Google Maps ↗</a><a class="photo-more" href="/photos">View all photos <span aria-hidden="true">→</span></a></div><div class="photo-preview-grid"><% if(!(site.photos||[]).length){ %><div class="empty-card"><h3>Photos coming soon</h3><p>Photos uploaded from the admin dashboard will appear here.</p></div><% } %><% (site.photos||[]).slice(0,2).forEach(photo=>{ %><figure class="photo-card"><img src="<%= photo.image %>" alt="<%= photo.caption || site.company.name %>"><% if(photo.caption){ %><figcaption><%= photo.caption %></figcaption><% } %></figure><% }) %></div></section><section id="about" class="section split"><div><span class="eyebrow">ABOUT US</span><h2>Practical solutions for modern agriculture.</h2></div><div><p><%= site.company.about %></p><div class="info-grid"><div><small>GSTIN</small><strong><%= site.company.gstin %></strong></div><div><small>Location</small><strong>Jajpur, Odisha</strong></div></div></div></section>
<section id="contact" class="section contact"><div class="contact-card"><div><span class="eyebrow">CONTACT</span><h2>Talk to <%= site.company.name %>.</h2><p>For product enquiries, solar rooftop installation support, pricing or branch information.</p></div><div class="contact-details"><% site.company.phones.forEach(phone=>{ %><a href="tel:<%= phone %>">+91 <%= phone %></a><% }) %><a href="mailto:<%= site.company.email %>"><%= site.company.email %></a><a class="address-link" href="<%= site.company.googleMapsUrl || '#' %>" target="_blank" rel="noopener noreferrer"><%= site.company.address %> ↗</a></div></div></section>
<div><strong><%= site.company.name %></strong><span>GSTIN: <%= site.company.gstin %></span></div><span>© <%= new Date().getFullYear() %> <%= site.company.name %>. All rights reserved.</span></footer>
<div class="modal hidden" id="branch-modal"><div class="modal-backdrop" data-close="1"></div><div class="modal-panel"><button class="modal-close" data-close="1" aria-label="Close">×</button><div id="modal-body"></div></div></div>
<script>
const modal=document.getElementById('branch-modal'), body=document.getElementById('modal-body');document.querySelectorAll('.location-card').forEach(btn=>btn.addEventListener('click',()=>{const src=document.getElementById(btn.dataset.branch);body.innerHTML=src.innerHTML;modal.classList.remove('hidden');document.body.classList.add('modal-open')}));document.querySelectorAll('[data-close]').forEach(x=>x.addEventListener('click',()=>{modal.classList.add('hidden');document.body.classList.remove('modal-open')}));document.addEventListener('keydown',e=>{if(e.key==='Escape'){modal.classList.add('hidden');document.body.classList.remove('modal-open')}});
</script></body></html>
