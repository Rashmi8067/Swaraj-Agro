<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= site.company.name %> — <%= site.company.tagline || 'Agro • Solar • Equipment' %></title>
  <meta name="description" content="<%= site.company.description || 'Farm machinery and solar rooftop solutions from Swaraj Agro.' %>">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="home-page reference-home">
  <%- include('partials/header', { activePage: 'home' }) %>
  <main>
    <section class="reference-hero" aria-labelledby="hero-title">
      <div class="reference-hero-copy">
        <span class="eyebrow">AGRICULTURE TODAY. A BRIGHTER TOMORROW.</span>
        <h1 id="hero-title">Powering Farms.<br>Building Better.</h1>
        <p><%= site.company.heroText || 'Reliable farm machinery and solar rooftop solutions to help farmers, homes and businesses grow a cleaner, stronger tomorrow.' %></p>
        <div class="reference-actions">
          <a class="ref-cta ref-cta-primary" href="/solar-solutions"><span class="ref-icon">☀</span>Explore Solar Solutions <span>→</span></a>
          <a class="ref-cta ref-cta-light" href="/farm-machinery"><span class="ref-icon">⚙</span>View Farm Machinery <span>→</span></a>
        </div>
        <div class="reference-trust-line">
          <span>✦</span><strong>Authorized Solar Vendor</strong><small>Under PM Surya Ghar Muft Bijli Yojana</small>
        </div>
      </div>
      <div class="reference-hero-art" aria-hidden="true">
        <div class="hero-photo hero-photo-left"></div>
        <div class="hero-photo hero-photo-right"></div>
        <div class="hero-sun-glow"></div>
        <div class="hero-haze"></div>
        <div class="hero-script">For<br>A Greener<br>Tomorrow</div>
      </div>
    </section>

    <section class="reference-stats" aria-label="Key trust points">
      <div><span class="stat-icon">👥</span><strong>2</strong><small>Business Verticals</small></div>
      <div><span class="stat-icon">🚜</span><strong>Farm</strong><small>Machinery Solutions</small></div>
      <div><span class="stat-icon">☀</span><strong>Solar</strong><small>Rooftop Solutions</small></div>
      <div><span class="stat-icon">📍</span><strong>Jajpur</strong><small>Local Support Base</small></div>
      <div><span class="stat-icon">✓</span><strong>Trusted</strong><small>Local Team</small></div>
    </section>

    <section class="reference-solutions section">
      <a class="reference-solution-card solar" href="/solar-solutions">
        <div class="solution-copy">
          <div class="solution-badge">☀</div>
          <h2>Solar Solutions</h2>
          <p>Clean energy for homes, businesses and a brighter future.</p>
          <span class="solution-link">Explore Solar <b>→</b></span>
        </div>
        <div class="solution-photo solar-photo"></div>
      </a>
      <a class="reference-solution-card farm" href="/farm-machinery">
        <div class="solution-copy">
          <div class="solution-badge">🚜</div>
          <h2>Farm Machinery</h2>
          <p>Reliable equipment built to support higher productivity.</p>
          <span class="solution-link">View Products <b>→</b></span>
        </div>
        <div class="solution-photo farm-photo"></div>
      </a>
    </section>

    <section class="reference-moments section">
      <div class="reference-section-head">
        <div><span class="eyebrow">OUR MOMENTS</span><h2>Glimpses from Our Journey</h2></div>
        <a class="circle-arrow-link" href="/photos" aria-label="View all photos">→</a>
      </div>
      <div class="reference-gallery-preview">
        <% if((site.photos || []).length){ %>
          <% (site.photos || []).slice(0,2).forEach(photo => { %>
            <figure class="gallery-preview-card"><img src="<%= photo.image %>" alt="<%= photo.caption || site.company.name %>"><% if(photo.caption){ %><figcaption><%= photo.caption %></figcaption><% } %></figure>
          <% }) %>
        <% } else { %>
          <figure class="gallery-preview-card"><img src="/assets/home-photo-1.jpg" alt="Swaraj Agro farm machinery visual"><figcaption>Farm machinery</figcaption></figure>
          <figure class="gallery-preview-card"><img src="/assets/home-photo-2.jpg" alt="Swaraj Agro solar visual"><figcaption>Solar rooftop solutions</figcaption></figure>
        <% } %>
        <a class="view-all-label" href="/photos">View all photos</a>
      </div>
    </section>

    <section class="reference-authorization">
      <div class="authorization-leaf">✦</div>
      <div><span class="eyebrow">AUTHORIZED SOLAR VENDOR</span><h2>Under PM Surya Ghar Muft Bijli Yojana</h2></div>
      <p>Supporting cleaner, more accessible solar energy for eligible homes and customers.</p>
    </section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
