<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= site.company.name %> — <%= site.company.tagline %></title><meta name="description" content="<%= site.company.description %>"><link rel="stylesheet" href="/site.css"></head><body>
<%- include('partials/public-header',{site,path:'/'}) %>
<main>
<section class="home-hero"><div class="home-hero-bg"></div><div class="home-hero-inner"><div class="hero-copy"><span class="eyebrow">AGRICULTURE TODAY. A BRIGHTER TOMORROW.</span><h1 class="hero-title">Powering Farms.<br><em>Building Better.</em></h1><p class="hero-lede">Swaraj Agro provides reliable farm machinery and solar rooftop solutions to help farmers, homes and businesses grow a cleaner, stronger tomorrow.</p><div class="hero-actions"><a class="btn btn-primary" href="/solar-solutions">Explore Solar Solutions <span>→</span></a><a class="btn btn-light" href="/farm-machinery">View Farm Machinery <span>→</span></a></div><div class="hero-trust"><span class="hero-trust-dot">✓</span><strong>Authorized Solar Vendor</strong><span>Under PM Surya Ghar Muft Bijli Yojana</span></div></div></div></section>
<section class="trust-stats"><div class="trust-stat"><div class="trust-icon">●</div><div><strong>2</strong><span>Core business areas</span></div></div><div class="trust-stat"><div class="trust-icon">⚙</div><div><strong>Farm</strong><span>Machinery solutions</span></div></div><div class="trust-stat"><div class="trust-icon">☀</div><div><strong>Solar</strong><span>Authorized rooftop vendor</span></div></div><div class="trust-stat"><div class="trust-icon">⌖</div><div><strong>Jajpur</strong><span>Local service base</span></div></div></section>
<section class="solution-section section"><span class="section-kicker">WHAT WE DO</span><h2 class="section-title">Two businesses. One trusted name.</h2><p class="section-sub">Explore the dedicated area that matches what you are looking for.</p><div class="solution-grid"><a class="solution-card" href="/solar-solutions"><img src="/assets/home-solar-card.jpg" alt="Solar rooftop solution"><div class="solution-content"><span class="eyebrow" style="color:#d9fb63">01 • SOLAR</span><h3>Solar Solutions</h3><p>Rooftop solar support for homes, businesses and eligible installations.</p><span class="solution-link">Explore Solar →</span></div></a><a class="solution-card" href="/farm-machinery"><img src="/assets/home-farm-card.jpg" alt="Farm machinery in field"><div class="solution-content"><span class="eyebrow" style="color:#d9fb63">02 • AGRICULTURE</span><h3>Farm Machinery</h3><p>Reliable equipment for soil preparation, harvesting and everyday farm work.</p><span class="solution-link">View Machinery →</span></div></a></div></section>
<section class="moments section"><div class="moments-head"><div><span class="section-kicker">OUR MOMENTS</span><h2 class="section-title">A glimpse of Swaraj Agro.</h2></div><a class="photo-link" href="/photos">View all photos →</a></div><div class="photo-preview"><% if((site.photos||[]).length){ (site.photos||[]).slice(0,2).forEach(photo=>{ %><figure><img src="<%= photo.image %>" alt="<%= photo.caption || site.company.name %>"><% if(photo.caption){ %><figcaption><%= photo.caption %></figcaption><% } %></figure><% }) } else { %><figure><img src="/assets/home-photo-1.jpg" alt="Swaraj Agro"><figcaption>Swaraj Agro</figcaption></figure><figure><img src="/assets/home-photo-2.jpg" alt="Swaraj Agro solar"><figcaption>Solar &amp; agriculture</figcaption></figure><% } %></div></section>
<section class="authorization"><div class="authorization-mark">✦</div><div><span class="eyebrow">SOLAR</span><h3>Authorized Solar Vendor</h3><p>Supporting rooftop installations under <strong>PM Surya Ghar Muft Bijli Yojana</strong>.</p></div><a class="btn btn-light" href="/contact">Talk to our team →</a></section>
<section class="home-contact"><div class="home-contact-inner"><div><span class="eyebrow" style="color:#d9fb63">READY WHEN YOU ARE</span><h2>Need a machine or a solar solution?</h2><p>Get pricing, product information, installation guidance or branch details from our team.</p></div><div class="contact-actions"><a class="btn btn-primary" href="/contact">Get in touch <span>→</span></a><a class="btn btn-light" href="/branches">Find a branch <span>→</span></a></div></div></section>
</main><%- include('partials/public-footer',{site}) %></body></html>
