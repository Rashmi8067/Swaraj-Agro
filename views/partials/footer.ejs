<footer class="site-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <img class="footer-logo footer-logo-default" src="/swaraj-agro-default.svg" alt="Swaraj Agro logo">
      <p>Agro • Solar • Equipment<br><span>Powering progress together.</span></p>
    </div>
    <div>
      <h4>Explore</h4>
      <a href="/">Home</a>
      <a href="/solar-solutions">Solar Solutions</a>
      <a href="/farm-machinery">Farm Machinery</a>
      <a href="/branches">Branches</a>
      <a href="/photos">Photos</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </div>
    <div>
      <h4>Contact</h4>
      <a href="mailto:<%= site.company.email %>"><%= site.company.email %></a>
      <% (site.company.phones || []).slice(0, 2).forEach(phone => { %>
        <a href="tel:<%= phone %>"><%= phone %></a>
      <% }) %>
      <% if(site.company.googleMapsUrl){ %>
        <a href="<%= site.company.googleMapsUrl %>" target="_blank" rel="noopener noreferrer"><%= site.company.address %> ↗</a>
      <% } else { %>
        <span><%= site.company.address %></span>
      <% } %>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© <%= new Date().getFullYear() %> <%= site.company.name %>. All rights reserved.</span>
    <span>GSTIN: <%= site.company.gstin %></span>
  </div>
</footer>
