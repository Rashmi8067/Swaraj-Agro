<% const current = typeof activePage !== 'undefined' ? activePage : ''; %>
<header class="nav reference-nav">
  <a class="brand reference-brand" href="/" aria-label="<%= site.company.name %> home">
    <img class="brand-logo reference-logo" src="/swaraj-agro-default.svg" alt="Swaraj Agro logo">
  </a>
  <nav class="desktop-nav reference-desktop-nav" aria-label="Primary navigation">
    <a class="<%= current === 'home' ? 'active' : '' %>" href="/">Home</a>
    <a href="/products">Products</a>
    <a class="<%= current === 'branches' ? 'active' : '' %>" href="/branches">Branches</a>
    <a class="<%= current === 'photos' ? 'active' : '' %>" href="/photos">Photos</a>
    <a class="<%= current === 'contact' ? 'active' : '' %>" href="/contact">Contact</a>
  </nav>
  <a class="admin-link reference-admin" href="/admin/login"><span class="admin-lock" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>Admin</a>
  <details class="mobile-menu reference-mobile-menu">
    <summary aria-label="Open navigation">Menu</summary>
    <div class="mobile-menu-panel">
      <a href="/">Home</a><a href="/farm-machinery">Farm Machinery</a><a href="/solar-solutions">Solar Solutions</a><a href="/branches">Our Branches</a><a href="/photos">Gallery</a><a href="/about">About Us</a><a href="/contact">Contact</a><a href="/admin/login">Admin</a>
    </div>
  </details>
</header>
<div class="mobile-floating-actions" aria-label="Quick contact">
  <% const quickPhone=(site.company.phones||[])[0] || ''; const waPhone=quickPhone.replace(/\D/g,''); %>
  <% if(waPhone){ %><a href="https://wa.me/91<%= waPhone %>" target="_blank" rel="noopener" aria-label="WhatsApp Swaraj Agro"><span>◔</span> WhatsApp</a><i aria-hidden="true"></i><% } %>
  <% if(quickPhone){ %><a href="tel:<%= quickPhone %>" aria-label="Call Swaraj Agro"><span>⌕</span> Call</a><% } %>
</div>
