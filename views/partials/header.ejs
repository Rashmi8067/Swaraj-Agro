<% const current = typeof activePage !== 'undefined' ? activePage : ''; %>
<header class="nav reference-nav">
  <a class="brand reference-brand" href="/" aria-label="<%= site.company.name %> home">
    <img class="brand-logo reference-logo" src="/swaraj-agro-default.svg" alt="Swaraj Agro logo">
  </a>
  <nav class="desktop-nav reference-desktop-nav" aria-label="Primary navigation">
    <a class="<%= current === 'home' ? 'active' : '' %>" href="/">Home</a>
    <a href="/products">Products</a>
    <a class="<%= current === 'branches' ? 'active' : '' %>" href="/branches">Branches</a>
    <a class="<%= current === 'photos' ? 'active' : '' %>" href="/photos">Photos</a>
    <a class="<%= current === 'contact' ? 'active' : '' %>" href="/contact">Contact</a>
    <button type="button" class="reference-desktop-customize" id="desktop-customize-trigger" aria-expanded="false" aria-controls="desktop-customize-popover"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M8 14v6"/></svg> Customize</button>
  </nav>
  <a class="admin-link desktop-admin-key" href="/admin/login" aria-label="Admin login" title="Admin login"><span class="admin-lock" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span></a>
  <div class="reference-mobile-controls">
    <a class="admin-link reference-admin" href="/admin/login" aria-label="Admin login" title="Admin login"><span class="admin-lock" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span></a>
    <button class="mobile-menu-trigger" id="site-menu-trigger" type="button" aria-label="Open navigation" aria-expanded="false"><span class="menu-bars" aria-hidden="true"><i></i><i></i><i></i></span></button>
    <div class="mobile-menu-overlay" id="site-mobile-overlay" aria-hidden="true"></div>
    <aside class="mobile-menu-panel" id="site-mobile-panel" aria-hidden="true">
      <div class="modern-menu-head"><div class="modern-menu-brand"><img src="/swaraj-agro-default.svg" alt=""><div><strong>Swaraj Agro</strong><small>Agro • Solar • Equipment</small></div></div><button class="modern-menu-close" id="modern-menu-close" type="button" aria-label="Close menu">×</button></div>
      <nav class="modern-menu-links" aria-label="Mobile navigation">
        <a href="/">Home</a><a href="/farm-machinery">Farm Machinery</a><a href="/solar-solutions">Solar Solutions</a><a href="/branches">Our Branches</a><a href="/photos">Gallery</a><a href="/about">About Us</a><a href="/contact">Contact</a>
      </nav>
      <section class="modern-menu-customize" aria-label="Website customization">
        <div class="modern-menu-customize-head"><strong>Customize</strong><span>Saved on this device</span></div>
        <div class="customize-row"><label>Website color</label><div class="customize-swatches" id="customize-colors">
          <button class="customize-swatch" data-accent="green" style="background:#146b49" aria-label="Swaraj green" title="Swaraj green"></button>
          <button class="customize-swatch" data-accent="forest" style="background:#285943" aria-label="Forest green" title="Forest green"></button>
          <button class="customize-swatch" data-accent="ocean" style="background:#176b82" aria-label="Ocean blue" title="Ocean blue"></button>
          <button class="customize-swatch" data-accent="indigo" style="background:#4b4b9b" aria-label="Indigo" title="Indigo"></button>
          <button class="customize-swatch" data-accent="terracotta" style="background:#b85c3c" aria-label="Terracotta" title="Terracotta"></button>
          <button class="customize-swatch" data-accent="plum" style="background:#74476f" aria-label="Plum" title="Plum"></button>
        </div></div>
        <div class="customize-row"><label>Font style</label><div class="customize-fonts" id="customize-fonts">
          <button class="customize-font-btn" data-font="DM Sans">DM Sans</button><button class="customize-font-btn" data-font="Space Grotesk">Space Grotesk</button><button class="customize-font-btn" data-font="Inter">Inter</button><button class="customize-font-btn" data-font="Manrope">Manrope</button><button class="customize-font-btn" data-font="Outfit">Outfit</button><button class="customize-font-btn" data-font="Poppins">Poppins</button><button class="customize-font-btn" data-font="Plus Jakarta Sans">Jakarta Sans</button><button class="customize-font-btn" data-font="Nunito Sans">Nunito Sans</button>
        </div></div>
        <div class="customize-row"><label>Mode</label><div class="customize-mode" id="customize-mode"><button class="customize-mode-btn" data-mode="light">☀ Light</button><button class="customize-mode-btn" data-mode="dark">◐ Dark</button></div></div>
        <button class="customize-reset" id="customize-reset" type="button">Reset to Swaraj defaults</button>
      </section>
    </aside>
  </div>
</header>
<div class="customize-desktop-popover" id="desktop-customize-popover" hidden>
  <section class="modern-menu-customize">
    <div class="modern-menu-customize-head"><strong>Customize website</strong><span>Saved on this device</span></div>
    <div class="customize-row"><label>Website color</label><div class="customize-swatches" data-customize-colors>
      <button class="customize-swatch" data-accent="green" style="background:#146b49" aria-label="Swaraj green"></button><button class="customize-swatch" data-accent="forest" style="background:#285943" aria-label="Forest green"></button><button class="customize-swatch" data-accent="ocean" style="background:#176b82" aria-label="Ocean blue"></button><button class="customize-swatch" data-accent="indigo" style="background:#4b4b9b" aria-label="Indigo"></button><button class="customize-swatch" data-accent="terracotta" style="background:#b85c3c" aria-label="Terracotta"></button><button class="customize-swatch" data-accent="plum" style="background:#74476f" aria-label="Plum"></button>
    </div></div>
    <div class="customize-row"><label>Font style</label><div class="customize-fonts" data-customize-fonts>
      <button class="customize-font-btn" data-font="DM Sans">DM Sans</button><button class="customize-font-btn" data-font="Space Grotesk">Space Grotesk</button><button class="customize-font-btn" data-font="Inter">Inter</button><button class="customize-font-btn" data-font="Manrope">Manrope</button><button class="customize-font-btn" data-font="Outfit">Outfit</button><button class="customize-font-btn" data-font="Poppins">Poppins</button><button class="customize-font-btn" data-font="Plus Jakarta Sans">Jakarta Sans</button><button class="customize-font-btn" data-font="Nunito Sans">Nunito Sans</button>
    </div></div>
    <div class="customize-row"><label>Mode</label><div class="customize-mode" data-customize-mode><button class="customize-mode-btn" data-mode="light">☀ Light</button><button class="customize-mode-btn" data-mode="dark">◐ Dark</button></div></div>
    <button class="customize-reset" data-customize-reset type="button">Reset to Swaraj defaults</button>
  </section>
</div>
<% if(activePage === 'farm' || activePage === 'solar'){ %>
<div class="mobile-floating-actions <%= activePage === 'farm' ? 'farm-quick-contact' : 'solar-quick-contact' %>" aria-label="Quick contact">
  <% const quickPhone=activePage === 'farm' ? '7735903203' : '9861515980'; const waPhone=quickPhone.replace(/\D/g,''); %>
  <a href="https://wa.me/91<%= waPhone %>" target="_blank" rel="noopener" aria-label="WhatsApp Swaraj Agro"><span>◔</span> WhatsApp</a><i aria-hidden="true"></i>
  <a href="tel:<%= quickPhone %>" aria-label="Call Swaraj Agro"><span>⌕</span> Call</a>
</div>
<% } %>
<script>
document.addEventListener('DOMContentLoaded',()=>{
  const body=document.body, root=document.documentElement, menu=document.getElementById('site-menu-trigger'), panel=document.getElementById('site-mobile-panel'), overlay=document.getElementById('site-mobile-overlay');
  const closeMenu=()=>{body.classList.remove('mobile-menu-open');menu?.setAttribute('aria-expanded','false');panel?.setAttribute('aria-hidden','true');overlay?.setAttribute('aria-hidden','true')};
  const openMenu=()=>{body.classList.add('mobile-menu-open');menu?.setAttribute('aria-expanded','true');panel?.setAttribute('aria-hidden','false');overlay?.setAttribute('aria-hidden','false')};
  menu?.addEventListener('click',()=>body.classList.contains('mobile-menu-open')?closeMenu():openMenu());
  overlay?.addEventListener('click',closeMenu); panel?.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',closeMenu));
  document.getElementById('modern-menu-close')?.addEventListener('click',closeMenu); document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMenu();closeCustomizer();}});

  const accents={green:['#146b49','#0d5138','#eaf5e8','#c7ef55'],forest:['#285943','#1b4432','#e8f1e9','#b9d7b6'],ocean:['#176b82','#0f5064','#e7f4f7','#8ed7e8'],indigo:['#4b4b9b','#373775','#eeeeff','#b8b8ff'],terracotta:['#b85c3c','#8f432c','#fff0e9','#f0b59e'],plum:['#74476f','#573353','#f6eaf4','#d9a9cf']};
  const fontFallback='DM Sans';
  const applyCustomization=()=>{
    const accent=localStorage.getItem('swarajPublicAccent')||'green', font=localStorage.getItem('swarajPublicFont')||fontFallback, mode=localStorage.getItem('swarajPublicTheme')||'light';
    const a=accents[accent]||accents.green; root.style.setProperty('--user-font',`'${font}',sans-serif`); root.style.setProperty('--user-accent',a[0]); root.style.setProperty('--user-accent2',a[1]); root.style.setProperty('--user-soft',a[2]); root.style.setProperty('--user-highlight',a[3]); root.dataset.publicTheme=mode;
    document.querySelectorAll('.customize-swatch').forEach(b=>b.classList.toggle('active',b.dataset.accent===accent));
    document.querySelectorAll('.customize-font-btn').forEach(b=>b.classList.toggle('active',b.dataset.font===font));
    document.querySelectorAll('.customize-mode-btn').forEach(b=>b.classList.toggle('active',b.dataset.mode===mode));
  };
  const bindCustomization=scope=>{
    scope?.querySelectorAll('.customize-swatch').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem('swarajPublicAccent',b.dataset.accent);applyCustomization();}));
    scope?.querySelectorAll('.customize-font-btn').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem('swarajPublicFont',b.dataset.font);applyCustomization();}));
    scope?.querySelectorAll('.customize-mode-btn').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem('swarajPublicTheme',b.dataset.mode);applyCustomization();}));
    scope?.querySelectorAll('[data-customize-reset],#customize-reset').forEach(b=>b.addEventListener('click',()=>{localStorage.removeItem('swarajPublicAccent');localStorage.removeItem('swarajPublicFont');localStorage.removeItem('swarajPublicTheme');applyCustomization();}));
  };
  const pop=document.getElementById('desktop-customize-popover'), trigger=document.getElementById('desktop-customize-trigger');
  const closeCustomizer=()=>{if(!pop)return;pop.hidden=true;trigger?.setAttribute('aria-expanded','false')};
  trigger?.addEventListener('click',e=>{e.stopPropagation();if(!pop)return;pop.hidden=!pop.hidden;trigger.setAttribute('aria-expanded',String(!pop.hidden));});
  pop?.addEventListener('click',e=>e.stopPropagation()); document.addEventListener('click',e=>{if(pop && !pop.hidden && !pop.contains(e.target) && e.target!==trigger)closeCustomizer();});
  bindCustomization(document); applyCustomization();
});
</script>
