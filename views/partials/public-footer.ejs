<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand-block">
      <% if(site.company.logo){ %><img src="<%= site.company.logo %>" alt="<%= site.company.name %> logo" class="footer-logo"><% } else { %><img src="/swaraj-agro-default.svg" alt="<%= site.company.name %> logo" class="footer-logo footer-logo-default"><% } %>
      <p>Agro • Solar • Equipment<br><span>Growing possibilities together.</span></p>
    </div>
    <div><h4>Explore</h4><a href="/">Home</a><a href="/solar-solutions">Solar Solutions</a><a href="/farm-machinery">Farm Machinery</a><a href="/branches">Branches</a><a href="/photos">Photos</a></div>
    <div><h4>Contact</h4><% site.company.phones.slice(0,2).forEach(phone=>{ %><a href="tel:<%= phone %>">+91 <%= phone %></a><% }) %><a href="mailto:<%= site.company.email %>"><%= site.company.email %></a><a href="<%= site.company.googleMapsUrl || '#' %>" target="_blank" rel="noopener noreferrer"><%= site.company.address %> ↗</a></div>
  </div>
  <div class="footer-bottom"><span>© <%= new Date().getFullYear() %> <%= site.company.name %>. All rights reserved.</span><span>GSTIN: <%= site.company.gstin %></span></div>
</footer>
