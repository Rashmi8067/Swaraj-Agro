<header class="site-nav">
  <a class="site-brand" href="/">
    <% if(site.company.logo){ %>
      <img src="<%= site.company.logo %>" alt="<%= site.company.name %> logo">
    <% } else { %>
      <img src="/swaraj-agro-default.svg" alt="<%= site.company.name %> logo">
    <% } %>
    <span class="brand-copy"><strong><%= site.company.name %></strong><small>Agro • Solar • Equipment</small></span>
  </a>
  <nav class="desktop-nav">
    <a class="<%= path === '/' ? 'active' : '' %>" href="/">Home</a>
    <a class="<%= path === '/solar-solutions' ? 'active' : '' %>" href="/solar-solutions">Solar Solutions</a>
    <a class="<%= path === '/farm-machinery' ? 'active' : '' %>" href="/farm-machinery">Farm Machinery</a>
    <a class="<%= path === '/branches' ? 'active' : '' %>" href="/branches">Branches</a>
    <a class="<%= path === '/photos' ? 'active' : '' %>" href="/photos">Photos</a>
    <a class="<%= path === '/contact' ? 'active' : '' %>" href="/contact">Contact</a>
    <a class="admin-pill" href="/admin/login">Admin</a>
  </nav>
  <button class="mobile-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">☰</button>
</header>
<div class="mobile-menu" hidden>
  <a href="/">Home</a><a href="/solar-solutions">Solar Solutions</a><a href="/farm-machinery">Farm Machinery</a><a href="/branches">Branches</a><a href="/photos">Photos</a><a href="/contact">Contact</a><a href="/admin/login">Admin</a>
</div>
<script>
  (function(){const b=document.querySelector('.mobile-menu-toggle'),m=document.querySelector('.mobile-menu'); if(!b||!m)return; b.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true'; b.setAttribute('aria-expanded',String(!open)); m.hidden=open; document.body.classList.toggle('menu-open',!open);});})();
</script>
