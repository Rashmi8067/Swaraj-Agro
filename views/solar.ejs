<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Solar Solutions — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'solar' }) %>
<main><section class="page-hero section"><span class="eyebrow">SOLAR SOLUTIONS</span><h1>Clean energy for homes and businesses.</h1><p>Explore our solar-related products and services, including rooftop installation support under PM Surya Ghar Muft Bijli Yojana.</p></section><section class="section solar-vendor-section"><div class="solar-vendor-card"><div class="solar-vendor-top"><div><span class="eyebrow">PM SURYA GHAR</span><h2>Our registered solar vendor profile.</h2><p class="solar-vendor-lead">DS Swaraj Agro is listed as a registered vendor for Jajpur, Odisha on the official PM Surya Ghar portal.</p></div><span class="solar-vendor-badge">✓ Official portal</span></div><div class="solar-vendor-stats"><div><strong>111+</strong><span>Installations</span></div><div><strong>333 kWp</strong><span>Total installed capacity</span></div><div><strong>5.0/5</strong><span>Vendor rating · 117 ratings</span></div></div><div class="solar-vendor-bottom"><span>Figures last verified from the official vendor listing.</span><a class="btn primary" href="https://pmsuryaghar.gov.in/#/registered-vendors" target="_blank" rel="noopener noreferrer">View official vendor profile ↗</a></div></div></section><section class="section"><div class="compact-product-grid"><% const items=site.products.filter(p=>p.category==='Solar Solution'); items.slice(0,2).forEach(p=>{ %><button class="compact-product-card" type="button" data-product-id="<%= p.id %>"><span class="compact-product-image"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% }else{ %><span>☀</span><% } %></span><span class="compact-product-copy"><strong><%= p.name %></strong><small><%= p.brand || '' %></small><small class="product-price"><%= p.price %></small></span></button><% }) %><a class="compact-view-all" href="/products?category=Solar%20Solution"><span><b>View All Products</b><small>See the complete solar solutions catalogue</small></span><span>→</span></a></div><% if(!items.length){ %><div class="empty-card"><h3>Solar Solutions coming soon</h3><p>Products can be added from the admin dashboard.</p></div><% } %></section><div class="product-modal" id="product-modal" aria-hidden="true"><div class="product-modal-backdrop" data-close-product></div><div class="product-modal-card" role="dialog" aria-modal="true"><button class="modal-close" type="button" data-close-product aria-label="Close">×</button><div class="product-modal-gallery"><button class="gallery-nav prev" type="button" aria-label="Previous photo">‹</button><img id="product-modal-image" src="" alt=""><button class="gallery-nav next" type="button" aria-label="Next photo">›</button><div class="gallery-counter" id="product-gallery-counter"></div></div><div class="product-modal-info"><span class="tag" id="product-modal-category"></span><h2 id="product-modal-name"></h2><div class="product-meta"><span id="product-modal-brand"></span><strong id="product-modal-price"></strong></div><p id="product-modal-description"></p><a class="btn primary" href="/contact">Enquire about this product →</a></div></div></div><script>const productData=<%- JSON.stringify(items).replace(/</g,'\u003c') %>;const pm=document.getElementById('product-modal'),pmi=document.getElementById('product-modal-image'),pmn=document.getElementById('product-modal-name'),pmb=document.getElementById('product-modal-brand'),pmp=document.getElementById('product-modal-price'),pmd=document.getElementById('product-modal-description'),pmc=document.getElementById('product-modal-category'),pgc=document.getElementById('product-gallery-counter');let currentProduct=null,currentPhoto=0;function productGallery(){return (currentProduct.gallery&&currentProduct.gallery.length?currentProduct.gallery:[currentProduct.image]).filter(Boolean)}function renderProduct(){const g=productGallery();pmi.src=g[currentPhoto]||'';pmi.alt=currentProduct.name||'';pmn.textContent=currentProduct.name||'';pmb.textContent=currentProduct.brand?`Brand: ${currentProduct.brand}`:'';pmp.textContent=currentProduct.price||'Contact for Price';pmd.textContent=currentProduct.description||'';pmc.textContent=currentProduct.subcategory||currentProduct.category||'';pgc.textContent=g.length>1?`${currentPhoto+1} / ${g.length}`:''}function openProduct(id){currentProduct=productData.find(p=>p.id===id);if(!currentProduct)return;currentPhoto=0;renderProduct();pm.classList.add('open');pm.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}function closeProduct(){pm.classList.remove('open');pm.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open')}document.querySelectorAll('[data-product-id]').forEach(x=>x.addEventListener('click',()=>openProduct(x.dataset.productId)));pm.querySelectorAll('[data-close-product]').forEach(x=>x.addEventListener('click',closeProduct));pm.querySelector('.prev').addEventListener('click',()=>{const g=productGallery();currentPhoto=(currentPhoto-1+g.length)%g.length;renderProduct()});pm.querySelector('.next').addEventListener('click',()=>{const g=productGallery();currentPhoto=(currentPhoto+1)%g.length;renderProduct()});let sx=0;pm.querySelector('.product-modal-gallery').addEventListener('touchstart',e=>sx=e.touches[0].clientX,{passive:true});pm.querySelector('.product-modal-gallery').addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>45){const g=productGallery();currentPhoto=(currentPhoto+(dx<0?1:-1)+g.length)%g.length;renderProduct()}});document.addEventListener('keydown',e=>{if(!pm.classList.contains('open'))return;if(e.key==='Escape')closeProduct();if(e.key==='ArrowLeft')pm.querySelector('.prev').click();if(e.key==='ArrowRight')pm.querySelector('.next').click()});</script></section></main><%- include('partials/footer') %></body></html>
