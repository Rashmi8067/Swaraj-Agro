<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Solar Solutions — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'solar' }) %>
<main><section class="page-hero section"><span class="eyebrow">SOLAR SOLUTIONS</span><h1>Clean energy for homes and businesses.</h1><p>Explore our solar-related products and services, including rooftop installation support under PM Surya Ghar Muft Bijli Yojana.</p></section><section class="section solar-vendor-section"><div class="solar-vendor-card solar-vendor-enhanced"><div class="solar-vendor-top"><div><span class="eyebrow">PM SURYA GHAR • REGISTERED VENDOR</span><h2><%= site.company.solarVendor?.name || 'DS Swaraj Agro' %></h2><p class="solar-vendor-lead">Registered solar rooftop vendor for <strong><%= site.company.solarVendor?.district || 'Jajpur' %>, <%= site.company.solarVendor?.state || 'Odisha' %></strong> under the Government of India’s PM Surya Ghar: Muft Bijli Yojana.</p></div><span class="solar-vendor-badge">✓ Verified Vendor</span></div><div class="solar-vendor-stats"><div><span class="vendor-stat-icon">♧</span><strong><%= site.company.solarVendor?.installations || '111' %>+</strong><span>Installations</span></div><div><span class="vendor-stat-icon">ϟ</span><strong><%= site.company.solarVendor?.capacity || '333 kWp' %></strong><span>Installed Capacity</span></div><div><span class="vendor-stat-icon">★</span><strong><%= site.company.solarVendor?.rating || '5.0/5' %></strong><span>Vendor Rating · <%= site.company.solarVendor?.ratingCount || '117' %> ratings</span></div></div><div class="vendor-logos"><span>☀ <strong>PM Surya Ghar</strong><small>Muft Bijli Yojana</small></span><span>▣ <strong>Ministry of New and Renewable Energy</strong><small>Government of India</small></span></div><div class="solar-vendor-bottom"><span><%= site.company.solarVendor?.syncStatus === 'success' ? 'Latest available figures synced from PM Surya Ghar.' : 'Figures are maintained from the official PM Surya Ghar vendor data when available.' %></span><a class="btn primary" href="<%= site.company.solarVendor?.portalUrl || 'https://pmsuryaghar.gov.in/#/registered-vendors' %>" target="_blank" rel="noopener noreferrer">View Our Official Vendor Profile ↗</a></div></div></section><section class="section"><div class="compact-product-grid"><% const items=site.products.filter(p=>p.category==='Solar Solution'); items.slice(0,2).forEach(p=>{ %><button class="compact-product-card" type="button" data-product-id="<%= p.id %>"><span class="compact-product-image"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% }else{ %><span>☀</span><% } %></span><span class="compact-product-copy"><strong><%= p.name %></strong><small><%= p.brand || '' %></small><small class="product-price"><%= p.price %></small></span></button><% }) %><a class="compact-view-all" href="/products?category=Solar%20Solution"><span><b>View All Products</b><small>See the complete solar solutions catalogue</small></span><span>→</span></a></div><% if(!items.length){ %><div class="empty-card"><h3>Solar Solutions coming soon</h3><p>Products can be added from the admin dashboard.</p></div><% } %></section><%- include('partials/product-modal', { items: items }) %></main><%- include('partials/footer') %></body></html>