<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Solar Solutions — <%= site.company.name %></title><link rel="stylesheet" href="/site.css"></head><body><%- include('partials/public-header',{site,path:'/solar-solutions'}) %><main><section class="page-hero"><div class="page-hero-inner"><span class="section-kicker">SOLAR SOLUTIONS</span><h1>Clean energy for homes, businesses and a brighter future.</h1><p>Explore our solar products and rooftop installation support, including eligible PM Surya Ghar Muft Bijli Yojana work.</p></div></section><section class="content-section section"><span class="section-kicker">CATALOGUE</span><h2 class="section-title">Solar products & services.</h2><div class="product-grid"><% site.products.filter(p=>p.category==='Solar Solution').forEach(p=>{ %><article class="product-card"><div class="product-image"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% } %><span>Solar</span></div><div class="product-body"><span class="product-tag"><%= p.subcategory || 'Solar Solution' %></span><h3><%= p.name %></h3><p><%= p.description %></p><div class="product-footer"><strong><%= p.price %></strong><a href="/contact">Enquire →</a></div></div></article><% }) %></div><% if(!site.products.filter(p=>p.category==='Solar Solution').length){ %><p class="section-sub">Solar products will appear here once added from the Admin panel.</p><% } %></section></main><%- include('partials/public-footer',{site}) %></body></html>
