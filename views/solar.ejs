<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Solar Solutions — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body><header class="nav"><a class="brand" href="/"><% if(site.company.logo){ %><img class="brand-logo" src="<%= site.company.logo %>"><% } else { %><img class="brand-logo brand-logo-default" src="/swaraj-agro-default.svg" alt="Swaraj Agro logo"><% } %><span><strong><%= site.company.name %></strong><small>Agro • Solar • Equipment</small></span></a><nav><a href="/">Home</a><a class="active" href="/solar-solutions">Solar Solutions</a><a href="/farm-machinery">Farm Machinery</a><a href="/branches">Branches</a><a href="/photos">Photos</a><a href="/contact">Contact</a><a class="admin-link" href="/admin/login">Admin</a></nav></header><main><section class="page-hero section"><span class="eyebrow">SOLAR SOLUTIONS</span><h1>Clean energy for homes and businesses.</h1><p>Explore our solar-related products and services, including rooftop installation support under PM Surya Ghar Muft Bijli Yojana.</p><a class="btn primary" href="/products?category=Solar%20Solution">Browse Solar Products →</a></section><section class="section"><div class="product-grid"><% const items=site.products.filter(p=>p.category==='Solar Solution'); items.forEach(p=>{ %><article class="card product"><div class="product-image"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% } else { %><div class="placeholder-icon">☀</div><% } %><span><%= p.category %></span></div><div class="card-body"><span class="tag"><%= p.subcategory || p.category %></span><h3><%= p.name %></h3><p><%= p.description %></p><div class="product-footer"><strong><%= p.price %></strong><a href="/contact">Enquire →</a></div></div></article><% }) %></div></section></main><%- include('partials/footer') %></body></html>
