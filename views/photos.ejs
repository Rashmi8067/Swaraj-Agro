<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Photos — <%= site.company.name %></title><meta name="description" content="Photos from <%= site.company.name %>"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'photos' }) %>
<main><section class="section photos-page"><div class="section-head"><div><span class="eyebrow">PHOTO GALLERY</span><h1>All photos</h1></div></div><p class="photos-intro">Explore photos from <%= site.company.name %>, organised by the work and places they show.</p><div class="gallery-view-toggle" role="group" aria-label="Gallery view"><button class="view-toggle active" data-view="tiles">Tile View</button><button class="view-toggle" data-view="list">List View</button></div><% const photoCategories=['Farm Machinery','Solar Rooftop Installation','Office Inside','Exterior','Other']; %><nav class="gallery-category-tabs" id="gallery-category-tabs" aria-label="Photo categories"><button class="gallery-category-tab active" type="button" data-category="Farm Machinery">Farm Machinery</button><button class="gallery-category-tab" type="button" data-category="Solar Rooftop Installation">Solar</button><button class="gallery-category-tab" type="button" data-category="Office Inside">Office Inside</button><button class="gallery-category-tab" type="button" data-category="Exterior">Exterior</button></nav><div id="photo-gallery" class="photo-gallery-wrap tiles-view"><% photoCategories.forEach(category=>{ const items=(site.photos||[]).filter(photo=>(photo.category||'Other')===category); %><% if(items.length){ %><section class="photo-category-section" data-photo-category-section="<%= category %>"><div class="photo-category-head"><span class="eyebrow"><%= category.toUpperCase() %></span><h2><%= category %></h2><span class="photo-category-count"><%= items.length %> photo<%= items.length===1?'':'s' %></span></div><div class="photo-grid full-gallery"><% items.forEach((photo,idx)=>{ %><button class="photo-card <%= idx>=5 ? 'tile-extra-photo' : '' %>" type="button" data-photo-image="<%= photo.image %>" data-photo-caption="<%= photo.caption || '' %>" data-photo-category="<%= category %>"><span class="photo-card-image"><img src="<%= photo.image %>" alt="<%= photo.caption || category + ' — ' + site.company.name %>"></span><span class="photo-card-meta"><span><%= category %></span><% if(photo.caption){ %><small><%= photo.caption %></small><% } %></span></button><% }) %><button class="tile-category-more" type="button" data-category="<%= category %>" aria-label="View all <%= category %> photos"><span>→</span><small>View all</small></button></div></section><% } %><% }) %></div><% if(!(site.photos||[]).length){ %><div class="empty-card"><h3>Photos coming soon</h3><p>Photos uploaded from the admin dashboard will appear here.</p></div><% } %></section></main><div class="tile-category-modal" id="tile-category-modal" aria-hidden="true"><div class="tile-category-backdrop" data-close-category></div><div class="tile-category-card" role="dialog" aria-modal="true"><div class="tile-category-head"><div><span class="eyebrow">PHOTO CATEGORY</span><h2 id="tile-category-title"></h2><span id="tile-category-count" class="muted"></span></div><button type="button" class="tile-category-close" data-close-category aria-label="Close">×</button></div><div class="tile-category-grid" id="tile-category-grid"></div></div></div><div class="photo-lightbox" id="photo-lightbox" aria-hidden="true"><div class="photo-lightbox-backdrop"></div><button class="photo-lightbox-nav prev" type="button" aria-label="Previous photo">‹</button><div class="photo-lightbox-content"><img id="lightbox-image" src="" alt=""><div class="lightbox-caption"><strong id="lightbox-category"></strong><span id="lightbox-text"></span></div></div><button class="photo-lightbox-nav next" type="button" aria-label="Next photo">›</button></div><script>const photoCards=[...document.querySelectorAll('.photo-card')],lb=document.getElementById('photo-lightbox'),lbi=document.getElementById('lightbox-image'),lbc=document.getElementById('lightbox-category'),lbt=document.getElementById('lightbox-text'),gallery=document.getElementById('photo-gallery'),categoryTabs=[...document.querySelectorAll('.gallery-category-tab')],categorySections=[...document.querySelectorAll('[data-photo-category-section]')],tileModal=document.getElementById('tile-category-modal'),tileGrid=document.getElementById('tile-category-grid'),tileTitle=document.getElementById('tile-category-title'),tileCount=document.getElementById('tile-category-count');let photoIndex=0;function renderLightbox(){const c=photoCards[photoIndex];if(!c)return;lbi.src=c.dataset.photoImage;lbi.alt=c.dataset.photoCaption||c.dataset.photoCategory;lbc.textContent=c.dataset.photoCategory;lbt.textContent=c.dataset.photoCaption||''}function changePhoto(dir){if(photoCards.length<2)return;photoIndex=(photoIndex+dir+photoCards.length)%photoCards.length;lbi.classList.remove('slide-in-left','slide-in-right');void lbi.offsetWidth;lbi.classList.add(dir>0?'slide-in-right':'slide-in-left');renderLightbox()}function openLightbox(i){photoIndex=i;renderLightbox();lb.classList.add('open');lb.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}function closeLightbox(){lb.classList.remove('open');lb.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open')}photoCards.forEach((c,i)=>c.addEventListener('click',()=>openLightbox(i)));lb.querySelector('.photo-lightbox-backdrop').addEventListener('click',closeLightbox);lb.addEventListener('click',e=>{if(e.target===lb||e.target===lb.querySelector('.photo-lightbox-backdrop'))closeLightbox()});lb.querySelector('.prev').addEventListener('click',()=>changePhoto(-1));lb.querySelector('.next').addEventListener('click',()=>changePhoto(1));let psx=0;lb.querySelector('.photo-lightbox-content').addEventListener('touchstart',e=>psx=e.touches[0].clientX,{passive:true});lb.querySelector('.photo-lightbox-content').addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-psx;if(Math.abs(dx)>45)changePhoto(dx<0?1:-1)},{passive:true});document.addEventListener('keydown',e=>{if(lb.classList.contains('open')){if(e.key==='Escape')closeLightbox();if(e.key==='ArrowLeft')changePhoto(-1);if(e.key==='ArrowRight')changePhoto(1)}if(tileModal&&tileModal.classList.contains('open')&&e.key==='Escape')closeCategoryModal()});function setListCategory(category){categoryTabs.forEach(t=>t.classList.toggle('active',t.dataset.category===category));categorySections.forEach(sec=>{sec.classList.toggle('category-hidden',sec.dataset.photoCategorySection!==category)});gallery.classList.add('list-view');gallery.classList.remove('tiles-view')}categoryTabs.forEach(t=>t.addEventListener('click',()=>setListCategory(t.dataset.category)));function categoryItems(category){return [...document.querySelectorAll('[data-photo-category-section="'+category+'"] .photo-card')]}function closeCategoryModal(){if(!tileModal)return;tileModal.classList.remove('open');tileModal.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open')}function openCategoryModal(category){if(!tileModal)return;const items=categoryItems(category);tileTitle.textContent=category;tileCount.textContent=items.length+' photo'+(items.length===1?'':'s');tileGrid.innerHTML='';items.forEach(card=>{const b=document.createElement('button');b.type='button';b.className='tile-popup-photo';const img=document.createElement('img');img.src=card.dataset.photoImage;img.alt=card.dataset.photoCaption||category;b.appendChild(img);if(card.dataset.photoCaption){const cap=document.createElement('span');cap.textContent=card.dataset.photoCaption;b.appendChild(cap)}b.addEventListener('click',()=>{const globalIndex=photoCards.indexOf(card);closeCategoryModal();openLightbox(globalIndex)});tileGrid.appendChild(b)});tileModal.classList.add('open');tileModal.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}document.querySelectorAll('.tile-category-more').forEach(b=>b.addEventListener('click',()=>openCategoryModal(b.dataset.category)));if(tileModal)tileModal.querySelectorAll('[data-close-category]').forEach(x=>x.addEventListener('click',closeCategoryModal));document.querySelectorAll('.view-toggle').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.view-toggle').forEach(x=>x.classList.toggle('active',x===b));const list=b.dataset.view==='list';gallery.classList.toggle('list-view',list);gallery.classList.toggle('tiles-view',!list);document.getElementById('gallery-category-tabs').classList.toggle('visible',list);if(list){const active=categoryTabs.find(t=>t.classList.contains('active'))||categoryTabs[0];if(active)setListCategory(active.dataset.category)}else{categorySections.forEach(sec=>sec.classList.remove('category-hidden'))}}));</script><%- include('partials/footer') %></body></html>
