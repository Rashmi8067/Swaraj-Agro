<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Photos — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body>
<header class="nav"><a class="brand" href="/"><% if(site.company.logo){ %><img class="brand-logo" src="<%= site.company.logo %>" alt="<%= site.company.name %> logo"><% } else { %><span class="brand-mark">DS</span><% } %><span><strong><%= site.company.name %></strong><small>Agro • Solar • Equipment</small></span></a><nav><a href="/#about">About</a><a href="/products">Products</a><a href="/#branches">Branches</a><a href="/photos">Photos</a><a href="/#contact">Contact</a><a class="admin-link" href="/admin/login">Admin</a></nav></header>
<main><section class="section photos-page"><div class="section-head"><div><span class="eyebrow">PHOTO GALLERY</span><h1>All photos</h1></div><div class="photos-page-actions"><a class="btn ghost" href="/">← Back to home</a><a class="btn primary" href="<%= site.company.googleMapsUrl || '#' %>" target="_blank" rel="noopener noreferrer">Google Maps ↗</a></div></div><p class="photos-intro">Explore photos uploaded by <%= site.company.name %>. For more photos and the public business listing, visit Google Maps.</p><div class="photo-grid full-gallery"><% if(!(site.photos||[]).length){ %><div class="empty-card"><h3>Photos coming soon</h3><p>Photos uploaded from the admin dashboard will appear here.</p></div><% } %><% (site.photos||[]).forEach(photo=>{ %><figure class="photo-card"><img src="<%= photo.image %>" alt="<%= photo.caption || site.company.name %>"><% if(photo.caption){ %><figcaption><%= photo.caption %></figcaption><% } %></figure><% }) %></div></section></main><footer><div><strong><%= site.company.name %></strong><span>GSTIN: <%= site.company.gstin %></span></div><span>© <%= new Date().getFullYear() %> <%= site.company.name %>. All rights reserved.</span></footer></body></html>