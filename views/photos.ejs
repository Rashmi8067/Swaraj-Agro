<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Photos — <%= site.company.name %></title><meta name="description" content="Photos from <%= site.company.name %>"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'photos' }) %>
<main><section class="section photos-page"><div class="section-head"><div><span class="eyebrow">PHOTO GALLERY</span><h1>All photos</h1></div></div><p class="photos-intro">Explore photos from <%= site.company.name %>, organised by the work and places they show.</p><div class="gallery-view-toggle" role="group" aria-label="Gallery view"><button class="view-toggle active" data-view="list">List View</button><button class="view-toggle" data-view="tiles">Tile View</button></div><% const photoCategories=['Farm Machinery','Solar Rooftop Installation','Office Inside','Exterior','Other']; %><div id="photo-gallery" class="photo-gallery-wrap list-view"><% photoCategories.forEach(category=>{ const items=(site.photos||[]).filter(photo=>(photo.category||'Other')===category); %><% if(items.length){ %><section class="photo-category-section"><div class="photo-category-head"><span class="eyebrow"><%= category.toUpperCase() %></span><h2><%= category %></h2><span class="photo-category-count"><%= items.length %> photo<%= items.length===1?'':'s' %></span></div><div class="photo-grid full-gallery"><% items.forEach(photo=>{ %><button class="photo-card" type="button" data-photo-image="<%= photo.image %>" data-photo-caption="<%= photo.caption || '' %>" data-photo-category="<%= category %>"><span class="photo-card-image"><img src="<%= photo.image %>" alt="<%= photo.caption || category + ' — ' + site.company.name %>"></span><span class="photo-card-meta"><span><%= category %></span><% if(photo.caption){ %><small><%= photo.caption %></small><% } %></span></button><% }) %></div></section><% } %><% }) %></div><% if(!(site.photos||[]).length){ %><div class="empty-card"><h3>Photos coming soon</h3><p>Photos uploaded from the admin dashboard will appear here.</p></div><% } %></section></main><div class="photo-lightbox" id="photo-lightbox" aria-hidden="true"><div class="photo-lightbox-backdrop"></div><button class="photo-lightbox-close" type="button" aria-label="Close">×</button><button class="photo-lightbox-nav prev" type="button" aria-label="Previous photo">‹</button><div class="photo-lightbox-content"><img id="lightbox-image" src="" alt=""><div class="lightbox-caption"><strong id="lightbox-category"></strong><span id="lightbox-text"></span></div></div><button class="photo-lightbox-nav next" type="button" aria-label="Next photo">›</button></div><script>const photoCards=[...document.querySelectorAll('.photo-card')],lb=document.getElementById('photo-lightbox'),lbi=document.getElementById('lightbox-image'),lbc=document.getElementById('lightbox-category'),lbt=document.getElementById('lightbox-text');let photoIndex=0;function renderLightbox(){const c=photoCards[photoIndex];lbi.src=c.dataset.photoImage;lbi.alt=c.dataset.photoCaption||c.dataset.photoCategory;lbc.textContent=c.dataset.photoCategory;lbt.textContent=c.dataset.photoCaption||''}function changePhoto(dir){if(photoCards.length<2)return;photoIndex=(photoIndex+dir+photoCards.length)%photoCards.length;lbi.classList.remove('slide-in-left','slide-in-right');void lbi.offsetWidth;lbi.classList.add(dir>0?'slide-in-right':'slide-in-left');renderLightbox()}function openLightbox(i){photoIndex=i;renderLightbox();lb.classList.add('open');lb.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}function closeLightbox(){lb.classList.remove('open');lb.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open')}photoCards.forEach((c,i)=>c.addEventListener('click',()=>openLightbox(i)));lb.querySelector('.photo-lightbox-close').addEventListener('click',closeLightbox);lb.querySelector('.photo-lightbox-backdrop').addEventListener('click',closeLightbox);lb.querySelector('.prev').addEventListener('click',()=>changePhoto(-1));lb.querySelector('.next').addEventListener('click',()=>changePhoto(1));let psx=0;lb.querySelector('.photo-lightbox-content').addEventListener('touchstart',e=>psx=e.touches[0].clientX,{passive:true});lb.querySelector('.photo-lightbox-content').addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-psx;if(Math.abs(dx)>45){changePhoto(dx<0?1:-1)}});document.addEventListener('keydown',e=>{if(!lb.classList.contains('open'))return;if(e.key==='Escape')closeLightbox();if(e.key==='ArrowLeft')lb.querySelector('.prev').click();if(e.key==='ArrowRight')lb.querySelector('.next').click()});document.querySelectorAll('.view-toggle').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.view-toggle').forEach(x=>x.classList.toggle('active',x===b));document.getElementById('photo-gallery').className='photo-gallery-wrap '+(b.dataset.view==='list'?'list-view':'tiles-view')}));</script><%- include('partials/footer') %></body></html>
