<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Photos — <%= site.company.name %></title><link rel="stylesheet" href="/site.css"></head><body><%- include('partials/public-header',{site,path:'/photos'}) %><main><section class="page-hero"><div class="page-hero-inner"><span class="section-kicker">PHOTO GALLERY</span><h1>Glimpses from our journey.</h1><p>Browse photos shared by <%= site.company.name %>. Your Google Maps listing remains available for the public business profile and directions.</p></div></section><section class="content-section section"><div class="photo-grid"><% if((site.photos||[]).length){ (site.photos||[]).forEach(photo=>{ %><figure class="photo-card"><img src="<%= photo.image %>" alt="<%= photo.caption || site.company.name %>"><% if(photo.caption){ %><figcaption><%= photo.caption %></figcaption><% } %></figure><% }) } else { %><figure class="photo-card"><img src="/assets/home-photo-1.jpg" alt="Swaraj Agro"><figcaption>Swaraj Agro</figcaption></figure><figure class="photo-card"><img src="/assets/home-photo-2.jpg" alt="Solar rooftop"><figcaption>Solar rooftop</figcaption></figure><% } %></div><div style="margin-top:28px"><a class="btn btn-primary" href="<%= site.company.googleMapsUrl || '#' %>" target="_blank" rel="noopener noreferrer">Open Google Maps ↗</a></div></section></main><%- include('partials/public-footer',{site}) %></body></html>
