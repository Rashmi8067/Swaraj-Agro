<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Photos — <%= site.company.name %></title><meta name="description" content="Photos from <%= site.company.name %>"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'photos' }) %>
<main><section class="section photos-page"><div class="section-head"><div><span class="eyebrow">PHOTO GALLERY</span><h1>All photos</h1></div><div class="photos-page-actions"><a class="btn ghost" href="/">← Back to home</a><% if(site.company.googleMapsUrl){ %><a class="btn primary" href="<%= site.company.googleMapsUrl %>" target="_blank" rel="noopener noreferrer">Google Maps ↗</a><% } %></div></div><p class="photos-intro">Explore photos from <%= site.company.name %>, organised by the work and places they show.</p>
<% const photoCategories=['Farm Machinery','Solar Rooftop Installation','Office Inside','Exterior','Other']; %>
<% photoCategories.forEach(category=>{ const items=(site.photos||[]).filter(photo=>(photo.category||'Other')===category); %>
  <% if(items.length){ %>
  <section class="photo-category-section"><div class="photo-category-head"><span class="eyebrow"><%= category.toUpperCase() %></span><h2><%= category %></h2><span class="photo-category-count"><%= items.length %> photo<%= items.length===1?'':'s' %></span></div><div class="photo-grid full-gallery">
    <% items.forEach(photo=>{ %><figure class="photo-card"><img src="<%= photo.image %>" alt="<%= photo.caption || category + ' — ' + site.company.name %>"><% if(photo.caption){ %><figcaption><%= photo.caption %></figcaption><% } %></figure><% }) %>
  </div></section>
  <% } %>
<% }) %>
<% if(!(site.photos||[]).length){ %><div class="empty-card"><h3>Photos coming soon</h3><p>Photos uploaded from the admin dashboard will appear here.</p></div><% } %>
</section></main><%- include('partials/footer') %></body></html>
