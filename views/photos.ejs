<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Photos — <%= site.company.name %></title><meta name="description" content="Photos from <%= site.company.name %>"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'photos' }) %>
<main><section class="section photos-page"><div class="section-head"><div><span class="eyebrow">PHOTO GALLERY</span><h1>All photos</h1></div><div class="photos-page-actions"><a class="btn ghost" href="/">← Back to home</a><% if(site.company.googleMapsUrl){ %><a class="btn primary" href="<%= site.company.googleMapsUrl %>" target="_blank" rel="noopener noreferrer">Google Maps ↗</a><% } %></div></div><p class="photos-intro">Explore photos uploaded by <%= site.company.name %>. Visit Google Maps for the public business listing and additional platform-hosted content.</p><div class="photo-grid full-gallery"><% if(!(site.photos||[]).length){ %><div class="empty-card"><h3>Photos coming soon</h3><p>Photos uploaded from the admin dashboard will appear here.</p></div><% } %><% (site.photos||[]).forEach(photo=>{ %><figure class="photo-card"><img src="<%= photo.image %>" alt="<%= photo.caption || site.company.name %>"><% if(photo.caption){ %><figcaption><%= photo.caption %></figcaption><% } %></figure><% }) %></div></section></main><%- include('partials/footer') %></body></html>
