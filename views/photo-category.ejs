<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= category %> — Photos — <%= site.company.name %></title><meta name="description" content="<%= category %> photos from <%= site.company.name %>"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'photos' }) %>
<main><section class="section photo-category-page"><div class="section-head"><div><span class="eyebrow">PHOTO GALLERY</span><h1><%= category %></h1><p class="photo-category-page-count"><%= items.length %> photo<%= items.length===1?'':'s' %></p></div></div><a class="photo-category-back" href="/photos">← Back to gallery</a><div class="photo-grid category-full-grid"><% items.forEach(photo=>{ %><button class="photo-card" type="button" data-photo-image="<%= photo.image %>" data-photo-caption="<%= photo.caption || '' %>" data-photo-category="<%= category %>"><span class="photo-card-image"><img src="<%= photo.image %>" alt="<%= photo.caption || category + ' — ' + site.company.name %>"></span><span class="photo-card-meta"><span><%= category %></span><% if(photo.caption){ %><small><%= photo.caption %></small><% } %></span></button><% }) %></div><% if(!items.length){ %><div class="empty-card"><h3>No photos yet</h3><p>Photos uploaded for this category will appear here.</p></div><% } %></section></main><div class="photo-lightbox" id="photo-lightbox" aria-hidden="true"><div class="photo-lightbox-backdrop"></div><button class="photo-lightbox-nav prev" type="button" aria-label="Previous photo">‹</button><div class="photo-lightbox-content"><img id="lightbox-image" src="" alt=""><div class="lightbox-caption"><strong id="lightbox-category"></strong><span id="lightbox-text"></span></div></div><button class="photo-lightbox-nav next" type="button" aria-label="Next photo">›</button></div><script>const photoCards=[...document.querySelectorAll('.photo-card')],lb=document.getElementById('photo-lightbox'),lbi=document.getElementById('lightbox-image'),lbc=document.getElementById('lightbox-category'),lbt=document.getElementById('lightbox-text');let photoIndex=0;function renderLightbox(dir=0){const c=photoCards[photoIndex];if(!c)return;if(dir){lbi.classList.remove('slide-in-left','slide-in-right');void lbi.offsetWidth;lbi.classList.add(dir>0?'slide-in-right':'slide-in-left')}lbi.src=c.dataset.photoImage;lbi.alt=c.dataset.photoCaption||c.dataset.photoCategory;lbc.textContent=c.dataset.photoCategory;lbt.textContent=c.dataset.photoCaption||''}function changePhoto(dir){if(photoCards.length<2)return;photoIndex=(photoIndex+dir+photoCards.length)%photoCards.length;renderLightbox(dir)}function openLightbox(i){photoIndex=i;renderLightbox();lb.classList.add('open');lb.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}function closeLightbox(){lb.classList.remove('open');lb.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open')}photoCards.forEach((c,i)=>c.addEventListener('click',()=>openLightbox(i)));lb.querySelector('.photo-lightbox-backdrop').addEventListener('click',closeLightbox);lb.addEventListener('click',e=>{if(e.target===lb||e.target===lb.querySelector('.photo-lightbox-content')||e.target===lb.querySelector('.lightbox-caption')||e.target===lbc||e.target===lbt)closeLightbox()});lb.querySelector('.prev').addEventListener('click',()=>changePhoto(-1));lb.querySelector('.next').addEventListener('click',()=>changePhoto(1));let psx=0;lb.querySelector('.photo-lightbox-content').addEventListener('touchstart',e=>psx=e.touches[0].clientX,{passive:true});lb.querySelector('.photo-lightbox-content').addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-psx;if(Math.abs(dx)>45)changePhoto(dx<0?1:-1)},{passive:true});document.addEventListener('keydown',e=>{if(!lb.classList.contains('open'))return;if(e.key==='Escape')closeLightbox();if(e.key==='ArrowLeft')changePhoto(-1);if(e.key==='ArrowRight')changePhoto(1)});</script><%- include('partials/footer') %></body></html>