<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= category %> Photos — <%= site.company.name %></title><meta name="description" content="<%= category %> photos from <%= site.company.name %>"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'photos' }) %>
<main><section class="section photos-page category-photo-page"><div class="section-head"><div><span class="eyebrow">PHOTO GALLERY</span><h1><%= category %></h1></div></div><p class="photos-intro">All <%= category.toLowerCase() %> photos from <%= site.company.name %>.</p><a class="category-back-link" href="/photos">← Back to gallery</a>
<% if(items.length){ %><div class="photo-grid category-full-grid"><% items.forEach(photo=>{ %><button class="photo-card" type="button" data-photo-image="<%= photo.image %>" data-photo-caption="<%= photo.caption || '' %>" data-photo-category="<%= category %>"><span class="photo-card-image"><img src="<%= photo.image %>" alt="<%= photo.caption || category + ' — ' + site.company.name %>"></span><span class="photo-card-meta"><span><%= category %></span><% if(photo.caption){ %><small><%= photo.caption %></small><% } %></span></button><% }) %></div><% } else { %><div class="empty-card"><h3>No photos yet</h3><p>Photos uploaded for this category will appear here.</p></div><% } %></section></main>
<div class="photo-lightbox" id="photo-lightbox" aria-hidden="true"><div class="photo-lightbox-backdrop"></div><button class="photo-lightbox-nav prev" type="button" aria-label="Previous photo">‹</button><div class="photo-lightbox-content"><img id="lightbox-image" src="" alt=""><div class="lightbox-caption"><strong id="lightbox-category"></strong><span id="lightbox-text"></span></div></div><button class="photo-lightbox-nav next" type="button" aria-label="Next photo">›</button></div>
<script>
const cards=[...document.querySelectorAll('.category-full-grid .photo-card')],lb=document.getElementById('photo-lightbox'),img=document.getElementById('lightbox-image'),cat=document.getElementById('lightbox-category'),txt=document.getElementById('lightbox-text');let i=0;
function render(){const c=cards[i];if(!c)return;img.src=c.dataset.photoImage;img.alt=c.dataset.photoCaption||c.dataset.photoCategory;cat.textContent=c.dataset.photoCategory;txt.textContent=c.dataset.photoCaption||''}
function change(d){if(cards.length<2)return;i=(i+d+cards.length)%cards.length;img.classList.remove('slide-in-left','slide-in-right');void img.offsetWidth;render();img.classList.add(d>0?'slide-in-right':'slide-in-left')}
function openAt(n){i=n;render();lb.classList.add('open');lb.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}
function close(){lb.classList.remove('open');lb.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open')}
cards.forEach((c,n)=>c.addEventListener('click',()=>openAt(n)));lb.addEventListener('click',e=>{if(e.target.closest('.photo-lightbox-nav')||e.target.closest('#lightbox-image')||e.target.closest('.lightbox-caption'))return;close()});lb.querySelector('.prev').addEventListener('click',e=>{e.stopPropagation();change(-1)});lb.querySelector('.next').addEventListener('click',e=>{e.stopPropagation();change(1)});let sx=0;lb.querySelector('.photo-lightbox-content').addEventListener('touchstart',e=>sx=e.touches[0].clientX,{passive:true});lb.querySelector('.photo-lightbox-content').addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>45)change(dx<0?1:-1)},{passive:true});document.addEventListener('keydown',e=>{if(!lb.classList.contains('open'))return;if(e.key==='Escape')close();if(e.key==='ArrowLeft')change(-1);if(e.key==='ArrowRight')change(1)});
</script><%- include('partials/footer') %></body></html>
