<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Branches — <%= site.company.name %></title><link rel="stylesheet" href="/site.css"></head><body><%- include('partials/public-header',{site,path:'/branches'}) %><main><section class="page-hero"><div class="page-hero-inner"><span class="section-kicker">OUR PRESENCE</span><h1>Branch locations.</h1><p>Choose a location to view branch details, contact information and directions.</p></div></section><section class="content-section section"><div class="branch-list"><% site.branches.forEach((b,i)=>{ %><button class="location-card" type="button" data-branch="branch-<%= i %>"><span class="location-pin">⌖</span><span class="location-copy"><strong><%= b.name %></strong><small><%= b.city || b.address %></small></span><span class="location-arrow">→</span></button><div class="branch-data" id="branch-<%= i %>" hidden><div class="branch-modal-content"><% if(b.image){ %><img src="<%= b.image %>" alt="<%= b.name %>"><% } %><span class="product-tag"><%= b.city || 'Branch' %></span><h3><%= b.name %></h3><p><%= b.description %></p><p><strong>Address:</strong> <%= b.address %></p><% if(b.phone){ %><p><strong>Phone:</strong> <a href="tel:<%= b.phone %>"><%= b.phone %></a></p><% } %><% if(b.email){ %><p><strong>Email:</strong> <a href="mailto:<%= b.email %>"><%= b.email %></a></p><% } %></p></div></div><% }) %></div><% if(!site.branches.length){ %><p class="section-sub">Branch locations will appear here when added from the Admin panel.</p><% } %></section></main><div class="modal hidden" id="branch-modal"><div class="modal-backdrop" data-close="1"></div><div class="modal-panel"><button class="modal-close" data-close="1" aria-label="Close">×</button><div id="modal-body"></div></div></div><script>const modal=document.getElementById('branch-modal'),body=document.getElementById('modal-body');document.querySelectorAll('.location-card').forEach(btn=>btn.addEventListener('click',()=>{const src=document.getElementById(btn.dataset.branch);body.innerHTML=src.innerHTML;modal.classList.remove('hidden')}));document.querySelectorAll('[data-close]').forEach(x=>x.addEventListener('click',()=>modal.classList.add('hidden')));document.addEventListener('keydown',e=>{if(e.key==='Escape')modal.classList.add('hidden')});</script><%- include('partials/public-footer',{site}) %></body></html>
