<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Branches — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body><header class="nav"><a class="brand" href="/"><% if(site.company.logo){ %><img class="brand-logo" src="<%= site.company.logo %>"><% } else { %><img class="brand-logo brand-logo-default" src="/swaraj-agro-default.svg" alt="Swaraj Agro logo"><% } %><span><strong><%= site.company.name %></strong><small>Agro • Solar • Equipment</small></span></a><nav><a href="/">Home</a><a href="/products?category=Solar%20Solution">Solar Solutions</a><a href="/products?category=Farm%20Machinery">Farm Machinery</a><a class="active" href="/branches">Branches</a><a href="/photos">Photos</a><a href="/contact">Contact</a><a class="admin-link" href="/admin/login">Admin</a></nav></header><main><section class="page-hero section"><span class="eyebrow">OUR PRESENCE</span><h1>Branch locations.</h1><p>Choose a location to view its details, contact information and photo.</p></section><section class="section alt"><div class="branch-locations"><% if(!site.branches.length){ %><div class="empty-card"><h3>More locations coming soon</h3><p>Branch locations can be added by the administrator.</p></div><% } %><% site.branches.forEach((b,i)=>{ %><button class="location-card" type="button" data-branch="branch-<%= i %>"><span class="location-pin">⌖</span><span><strong><%= b.name %></strong><small><%= b.city || b.address %></small></span><span class="location-arrow">→</span></button><div class="branch-data hidden" id="branch-<%= i %>"><div class="branch-modal-content"><% if(b.image){ %><img src="<%= b.image %>" alt="<%= b.name %>"><% } %><span class="tag"><%= b.city %></span><h3><%= b.name %></h3><p><%= b.description %></p><p class="muted"><strong>Address:</strong> <%= b.address %></p><p class="muted"><strong>Phone:</strong> <%= b.phone || 'Not provided' %></p><p class="muted"><strong>Email:</strong> <%= b.email || 'Not provided' %></p></div></div><% }) %></div></section></main><footer class="site-footer"><div class="footer-bottom"><span>© <%= new Date().getFullYear() %> <%= site.company.name %>. All rights reserved.</span><span>GSTIN: <%= site.company.gstin %></span></div></footer><div class="modal hidden" id="branch-modal"><div class="modal-backdrop" data-close="1"></div><div class="modal-panel"><button class="modal-close" data-close="1" aria-label="Close">×</button><div id="modal-body"></div></div></div><script>const modal=document.getElementById('branch-modal'),body=document.getElementById('modal-body');document.querySelectorAll('.location-card').forEach(btn=>btn.addEventListener('click',()=>{const src=document.getElementById(btn.dataset.branch);body.innerHTML=src.innerHTML;modal.classList.remove('hidden');document.body.classList.add('modal-open')}));document.querySelectorAll('[data-close]').forEach(x=>x.addEventListener('click',()=>{modal.classList.add('hidden');document.body.classList.remove('modal-open')}));document.addEventListener('keydown',e=>{if(e.key==='Escape'){modal.classList.add('hidden');document.body.classList.remove('modal-open')}});</script></body></html>
