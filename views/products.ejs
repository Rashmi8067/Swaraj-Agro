<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Products — <%= site.company.name %></title><link rel="stylesheet" href="/site.css"></head><body><%- include('partials/public-header',{site,path:'/products'}) %><main><section class="page-hero"><div class="page-hero-inner"><span class="section-kicker">PRODUCTS</span><h1><% if(category){ %><%= category %><% } else if(q){ %>Search results<% } else { %>Our product catalogue<% } %></h1><p>Choose a main category and explore the products currently published by Swaraj Agro.</p></div></section><section class="content-section section"><form class="product-filters" action="/products" method="get"><a class="filter-pill <%= !category?'active':'' %>" href="/products">All products</a><a class="filter-pill <%= category==='Solar Solution'?'active':'' %>" href="/products?category=Solar%20Solution">Solar Solution</a><a class="filter-pill <%= category==='Farm Machinery'?'active':'' %>" href="/products?category=Farm%20Machinery">Farm Machinery</a><input type="text" name="q" value="<%= q %>" placeholder="Search products..." style="flex:1;min-width:220px;padding:11px 14px;border:1px solid var(--line);border-radius:999px"><button class="filter-pill active" type="submit">Search</button></form><div class="product-grid"><% items.forEach(p=>{ %><article class="product-card"><div class="product-image"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% } %><span><%= p.category %></span></div><div class="product-body"><span class="product-tag"><%= p.subcategory || p.category %></span><h3><%= p.name %></h3><p><%= p.description %></p><div class="product-footer"><strong><%= p.price %></strong><a href="/contact">Enquire →</a></div></div></article><% }) %></div><% if(!items.length){ %><p class="section-sub">No products found yet. Add products from the Admin panel.</p><% } %></section></main><%- include('partials/public-footer',{site}) %></body></html>
