<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Farm Machinery — <%= site.company.name %></title><link rel="stylesheet" href="/site.css"></head><body><%- include('partials/public-header',{site,path:'/farm-machinery'}) %><main><section class="page-hero"><div class="page-hero-inner"><span class="section-kicker">FARM MACHINERY</span><h1>Equipment made for real farm work.</h1><p>Browse our agricultural machinery catalogue for soil preparation, harvesting and other everyday farm operations.</p></div></section><section class="content-section section"><span class="section-kicker">CATALOGUE</span><h2 class="section-title">Farm machinery.</h2><div class="product-grid"><% site.products.filter(p=>p.category==='Farm Machinery').forEach(p=>{ %><article class="product-card"><div class="product-image"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% } %><span>Farm Machinery</span></div><div class="product-body"><span class="product-tag"><%= p.subcategory || 'Farm Machinery' %></span><h3><%= p.name %></h3><p><%= p.description %></p><div class="product-footer"><strong><%= p.price %></strong><a href="/contact">Enquire →</a></div></div></article><% }) %></div><% if(!site.products.filter(p=>p.category==='Farm Machinery').length){ %><p class="section-sub">Farm machinery products will appear here once added from the Admin panel.</p><% } %></section></main><%- include('partials/public-footer',{site}) %></body></html>
