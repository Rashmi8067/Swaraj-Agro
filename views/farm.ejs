<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Farm Machinery — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'farm' }) %>
<main><section class="page-hero section"><span class="eyebrow">FARM MACHINERY</span><h1>Equipment made for real farm work.</h1><p>Browse our agricultural machinery catalogue for soil preparation, harvesting and other farm operations.</p><a class="btn primary" href="/products?category=Farm%20Machinery">Browse Farm Machinery →</a></section><section class="section"><div class="product-grid"><% const items=site.products.filter(p=>p.category==='Farm Machinery'); items.forEach(p=>{ %><article class="card product"><div class="product-image"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% } else { %><div class="placeholder-icon">⚙</div><% } %><span><%= p.category %></span></div><div class="card-body"><span class="tag"><%= p.subcategory || p.category %></span><h3><%= p.name %></h3><p><%= p.description %></p><div class="product-footer"><strong><%= p.price %></strong><a href="/contact">Enquire →</a></div></div></article><% }) %></div><% if(!items.length){ %><div class="empty-card"><h3>Farm machinery coming soon</h3><p>Products can be added from the admin dashboard.</p></div><% } %></section></main><%- include('partials/footer') %></body></html>
