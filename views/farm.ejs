<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Farm Machinery — <%= site.company.name %></title><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/header', { activePage: 'farm' }) %>
<main><section class="page-hero section"><span class="eyebrow">FARM MACHINERY</span><h1>Equipment made for real farm work.</h1><p>Browse our agricultural machinery catalogue for soil preparation, harvesting and other farm operations.</p></section><section class="section"><div class="compact-product-grid"><% const items=site.products.filter(p=>p.category==='Farm Machinery'); items.slice(0,2).forEach(p=>{ %><button class="compact-product-card" type="button" data-product-id="<%= p.id %>"><span class="compact-product-image"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>"><% }else{ %><span>⚙</span><% } %></span><span class="compact-product-copy"><strong><%= p.name %></strong><small><%= p.brand || '' %></small><small class="product-price"><%= p.price %></small></span></button><% }) %><a class="compact-view-all" href="/products?category=Farm%20Machinery"><span><b>View All Products</b><small>See the complete farm machinery catalogue</small></span><span>→</span></a></div><% if(!items.length){ %><div class="empty-card"><h3>Farm Machinery coming soon</h3><p>Products can be added from the admin dashboard.</p></div><% } %></section><%- include('partials/product-modal', { items: items }) %></main><%- include('partials/footer') %></body></html>